  PENDING
  APPROVED
  REJECTED
}

enum DeliveryRequestStatus {
  PENDING
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// DB-backed lifecycle. `PENDING` lives on DeliveryRequest; the job starts at ASSIGNED.
enum DeliveryJobStatus {
  ASSIGNED
  ACCEPTED
  TO_PICKUP
  AT_PICKUP
  TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryProofType {
  PHOTO
  OTP
  SIGNATURE
}

enum AgentEarningStatus {
  PENDING
  PAID
}

