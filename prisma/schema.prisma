model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  email                     String                  @unique
  name                      String
  phone                     String?
  phoneVerifiedAt           DateTime?               @map("phone_verified_at") @db.Timestamptz(6)
  passwordHash              String?                 @map("password_hash")
  emailVerifiedAt           DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  twoFactorEnabled          Boolean                 @default(false) @map("two_factor_enabled")
  twoFactorSecret           String?                 @map("two_factor_secret")
  twoFactorLastStep         Int?                    @map("two_factor_last_step")
  role                      UserRole                @default(CUSTOMER)
  status                    UserStatus              @default(ACTIVE)
  sessionVersion            Int                     @default(0) @map("session_version")
  vendor                    Vendor?                 @relation("VendorOwner")
  reviewedVendors           Vendor[]                @relation("VendorReviewer")
  reviewedProducts          Product[]               @relation("ProductReviewer")
  inventoryMovements        InventoryMovement[]     @relation("InventoryActor")
  accountTokens             AccountToken[]
  auditEvents               AuditLog[]              @relation("AuditActor")
  cart                      Cart?
  orders                    Order[]                 @relation("CustomerOrders")
  requestedRefunds          Refund[]                @relation("RefundRequester")
  createdPayouts            Payout[]                @relation("PayoutCreator")
  couponRedemptions         CouponRedemption[]      @relation("CouponRedeemer")
  businessMemberships       BusinessMember[]        @relation("BusinessMemberships")
  sentInvitations           BusinessMember[]        @relation("SentInvitations")
  reviewedBusinessDocuments BusinessDocument[]      @relation("ReviewedBusinessDocuments")
  openedPosSessions         PosSession[]            @relation("PosSessionOpener")
  closedPosSessions         PosSession[]            @relation("PosSessionCloser")
  soldPosSales              Sale[]                  @relation("SaleSoldBy")
  recordedExpenses          Expense[]               @relation("ExpenseRecorder")
  warehouseTransfers        WarehouseTransfer[]     @relation("WarehouseTransferActor")
  wishlist                  WishlistItem[]          @relation("UserWishlist")
  orderStatusEvents         OrderStatusHistory[]    @relation("OrderStatusActor")
  reviews                   ProductReview[]         @relation("ReviewAuthor")
  returnRequests            ReturnRequest[]         @relation("ReturnRequester")
  deliveryAgent             DeliveryAgent?          @relation("DeliveryAgentUser")
  deliveryRequests          DeliveryRequest[]       @relation("DeliveryRequester")
  reviewedAgentDocuments    AgentDocument[]         @relation("AgentDocumentReviewer")
  deliveryStatusEvents      DeliveryStatusHistory[] @relation("DeliveryStatusActor")
  submittedRfqs             Rfq[]                   @relation("RfqSubmitter")
  submittedPurchaseOrders   BusinessPurchaseOrder[] @relation("PurchaseOrderSubmitter")
  buyerChats                Chat[]                  @relation("BuyerChats")
  chatMessages              ChatMessage[]           @relation("ChatMessageSender")
  customerRecords           Customer[]              @relation("CustomerUser")
  loyaltyAccount            LoyaltyAccount?
  backupCodes               BackupCode[]
  phoneVerifications        PhoneVerification[]
  aiRecommendations         AiRecommendationHistory[]
  signInEvents              SignInEvent[]
  serviceBookings           ServiceBooking[]       @relation("ServiceBookingBuyer")
  groupBuyParticipations    GroupBuyParticipation[] @relation("GroupBuyParticipations")
  installmentAgreements     InstallmentAgreement[] @relation("InstallmentBuyer")
  installmentDisputes       InstallmentDispute[] @relation("InstallmentDisputeOpener")
  installmentSignatures     InstallmentContractSignature[] @relation("InstallmentSigner")
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role, status])
  @@map("users")
}

// ── Phase 1: Business Identity ───────────────────────────────────────────────

model BusinessCategory {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  slug       String             @unique
  parentId   String?            @map("parent_id") @db.Uuid
  parent     BusinessCategory?  @relation("BusinessCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   BusinessCategory[] @relation("BusinessCategoryHierarchy")
  sortOrder  Int                @default(0) @map("sort_order")
  businesses Business[]
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([parentId])
  @@map("business_categories")
}

model Business {
  id                 String                  @id @default(uuid()) @db.Uuid
  businessCode       String                  @unique @map("business_code")
  name               String
  slug               String                  @unique
  categoryId         String?                 @map("category_id") @db.Uuid
  category           BusinessCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  verificationStatus String                  @default("unverified") @map("verification_status")
  description        String?
  logoKey            String?                 @map("logo_key")
  website            String?
  contactPhone       String?                 @map("contact_phone")
  contactEmail       String?                 @map("contact_email")
  members            BusinessMember[]
  branches           BusinessBranch[]
  roles              BusinessRole[]
  documents          BusinessDocument[]
  settings           BusinessSettings?
  vendors            Vendor[]
  deliveryRequests   DeliveryRequest[]
  wholesaleListings  WholesaleListing[]
  buyingRfqs         Rfq[]                   @relation("RfqBuyer")
  purchaseOrders     BusinessPurchaseOrder[]
  invoices           BusinessInvoice[]
  subscriptions      BusinessSubscription[]
  installmentSettings InstallmentSetting?
  installmentAgreements InstallmentAgreement[]
  installmentReconciliationRuns InstallmentReconciliationRun[]
  aiInsights         BusinessAiInsight[]
  serviceListings    ServiceListing[]
  groupBuyCampaigns  GroupBuyCampaign[]      @relation("GroupBuyCampaigns")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([verificationStatus])
  @@map("businesses")
}

model BusinessBranch {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  branchCode String   @map("branch_code")
  address    String?
  city       String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isPrimary  Boolean  @default(false) @map("is_primary")
  corridorOrigins    RegionalCorridor[] @relation("CorridorOrigin")
  corridorDestinations RegionalCorridor[] @relation("CorridorDestination")
  corridorStops      CorridorStop[]      @relation("CorridorStops")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([businessId, branchCode])
  @@index([businessId])
  @@map("business_branches")
}

model Permission {
  id            String           @id @default(uuid()) @db.Uuid
  permissionKey String           @unique @map("permission_key")
  description   String           @default("")
  roles         RolePermission[]
  logisticsRolePermissions LogisticsRolePermission[]

  @@map("permissions")
}

model BusinessRole {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean          @default(false) @map("is_system")
  permissions RolePermission[]
  members     MemberRole[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([businessId, name])
  @@map("business_roles")
}

model RolePermission {
  roleId       String       @map("role_id") @db.Uuid
  role         BusinessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String       @map("permission_id") @db.Uuid
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model BusinessMember {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation("BusinessMemberships", fields: [userId], references: [id], onDelete: Cascade)
  status      String       @default("active")
  invitedById String?      @map("invited_by") @db.Uuid
  invitedBy   User?        @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  roles       MemberRole[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId])
  @@map("business_members")
}

model MemberRole {
  memberId String         @map("member_id") @db.Uuid
  member   BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String         @map("role_id") @db.Uuid
  role     BusinessRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model BusinessDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documentType       String    @map("document_type")
  storageKey         String    @unique @map("storage_key")
  verificationStatus String    @default("pending") @map("verification_status")
  reviewedById       String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?     @relation("ReviewedBusinessDocuments", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote         String?   @map("review_note")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId])
  @@map("business_documents")
}

model BusinessSettings {
  businessId   String   @map("business_id") @db.Uuid
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  settingsJson Json     @default("{}") @map("settings_json")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([businessId])
  @@map("business_settings")
}

// ── End Phase 1 ───────────────────────────────────────────────────────────────

model Vendor {
  id                 String                  @id @default(uuid()) @db.Uuid
  ownerId            String                  @unique @map("owner_id") @db.Uuid
  owner              User                    @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  businessId         String?                 @map("business_id") @db.Uuid
  business           Business?               @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name               String
  slug               String                  @unique
  description        String?
  monogram           String?
  location           String?
  contactPhone       String?                 @map("contact_phone")
  city               String?
  street             String?
  address            String?
  latitude           Decimal?                @db.Decimal(10, 7)
  longitude          Decimal?                @db.Decimal(10, 7)
  discipline         String?
  story              String?
  status             VendorStatus            @default(PENDING)
  reviewNote         String?                 @map("review_note")
  appealReason       String?                 @map("appeal_reason")
  appealedAt         DateTime?               @map("appealed_at") @db.Timestamptz(6)
  appealReviewedAt   DateTime?               @map("appeal_reviewed_at") @db.Timestamptz(6)
  appealReviewNote   String?                 @map("appeal_review_note")
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  reviewedById       String?                 @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?                   @relation("VendorReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  departments        VendorDepartment[]
  products           Product[]
  vendorOrders       VendorOrder[]
  shipments          Shipment[]
  promotions         Promotion[]
  commissionEntries  CommissionLedger[]
  payouts            Payout[]
  warehouses         Warehouse[]
  warehouseTransfers WarehouseTransfer[]
  posRegisters       PosRegister[]
  posSessions        PosSession[]
  sales              Sale[]
  expenses           Expense[]
  wholesaleListings  WholesaleListing[]
  supplierRfqs       Rfq[]                   @relation("RfqSupplier")
  quotations         SupplierQuotation[]
  purchaseOrders     BusinessPurchaseOrder[]
  invoices           BusinessInvoice[]
  chats              Chat[]                  @relation("VendorChats")
  customers          Customer[]
  serviceListings    ServiceListing[]
  serviceBookings    ServiceBooking[]       @relation("ServiceBookings")
  groupBuyCampaigns  GroupBuyCampaign[]     @relation("GroupBuyCampaigns")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([status, createdAt])
  @@index([businessId])
  @@map("vendors")
}

model Category {
  id          String             @id @default(uuid()) @db.Uuid
  parentId    String?            @map("parent_id") @db.Uuid
  parent      Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]         @relation("CategoryHierarchy")
  name        String
  slug        String             @unique
  headline    String             @default("")
  description String             @default("")
  status      CategoryStatus     @default(ACTIVE)
  sortOrder   Int                @default(0) @map("sort_order")
  products    Product[]
  promotions  Promotion[]
  vendors     VendorDepartment[]
  serviceListings ServiceListing[]
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, sortOrder])
  @@index([parentId])
  @@map("categories")
}

model VendorDepartment {
  vendorId   String   @map("vendor_id") @db.Uuid
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([vendorId, categoryId])
  @@index([categoryId])
  @@map("vendor_departments")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryId         String              @map("category_id") @db.Uuid
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug               String              @unique
  name               String
  sku                String
  summary            String
  description        String
  makerNote          String              @default("") @map("maker_note")
  materials          String[]            @default([])
  dimensions         String              @default("")
  care               String              @default("")
  searchText         String              @default("") @map("search_text")
  price              Decimal             @db.Decimal(12, 2)
  costPrice          Decimal?            @map("cost_price") @db.Decimal(12, 2)
  compareAtPrice     Decimal?            @map("compare_at_price") @db.Decimal(12, 2)
  currency           String              @default("TZS") @db.VarChar(3)
  stock              Int                 @default(0)
  status             ProductStatus       @default(DRAFT)
  featured           Boolean             @default(false)
  reviewNote         String?             @map("review_note")
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  reviewedById       String?             @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?               @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz(6)
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?           @map("archived_at") @db.Timestamptz(6)
  variants           ProductVariant[]
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
  warehouseTransfers WarehouseTransfer[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  saleItems          SaleItem[]
  wishlistedBy       WishlistItem[]
  reviews            ProductReview[]
  wholesaleListings  WholesaleListing[]
  chats              Chat[]
  aiRecommendations  AiRecommendationHistory[]
  groupBuyCampaigns  GroupBuyCampaign[]
  installmentReservations InstallmentStockReservation[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, sku])
  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([status, featured])
  @@map("products")
}

enum PromotionScope {
  MARKETPLACE
  VENDOR
  CATEGORY
}

/// A scheduled percentage promotion that applies automatically at checkout. The
/// platform funds it, so studio subtotals and future payouts stay whole.
model Promotion {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String         @default("")
  scope       PromotionScope @default(MARKETPLACE)
  vendorId    String?        @map("vendor_id") @db.Uuid
  vendor      Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId  String?        @map("category_id") @db.Uuid
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  percent     Int
  currency    String         @default("TZS") @db.VarChar(3)
  startsAt    DateTime       @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime?      @map("ends_at") @db.Timestamptz(6)
  isActive    Boolean        @default(true) @map("is_active")
  createdById String?        @map("created_by_id") @db.Uuid
  orders      Order[]
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, scope])
  @@map("promotions")
}

model ProductVariant {
  id         String      @id @default(uuid()) @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String
  price      Decimal     @db.Decimal(12, 2)
  stock      Int         @default(0)
  isActive   Boolean     @default(true) @map("is_active")
  sortOrder  Int         @default(0) @map("sort_order")
  cartItems  CartItem[]
  orderItems OrderItem[]
  saleItems  SaleItem[]
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([productId, sku])
  @@index([productId, sortOrder])
  @@map("product_variants")
}

model ProductImage {
  id          String             @id @default(uuid()) @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String             @unique @map("storage_key")
  alt         String
  contentType String             @map("content_type")
  byteSize    Int                @map("byte_size")
  sortOrder   Int                @default(0) @map("sort_order")
  status      ProductImageStatus @default(APPROVED)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model WarehouseTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  vendorId        String    @map("vendor_id") @db.Uuid
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productId       String    @map("product_id") @db.Uuid
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouseId String    @map("from_warehouse_id") @db.Uuid
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String    @map("to_warehouse_id") @db.Uuid
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  quantity        Int
  note            String?
  actorId         String?   @map("actor_id") @db.Uuid
  actor           User?     @relation("WarehouseTransferActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId, createdAt])
  @@index([productId, createdAt])
  @@map("warehouse_transfers")
}

model InventoryMovement {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId        String?         @map("actor_id") @db.Uuid
  actor          User?           @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  warehouseId    String?         @map("warehouse_id") @db.Uuid
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  delta          Int
  reason         InventoryReason
  resultingStock Int             @map("resulting_stock")
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("inventory_movements")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @unique @map("user_id") @db.Uuid
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?    @unique @map("guest_token_hash")
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(6)
  items          CartItem[]
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @map("cart_id") @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Uniqueness is enforced by two partial indexes: one line per product for base
  // products, and one line per product+variant for variant products.
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                   String               @id @default(uuid()) @db.Uuid
  orderNumber          String               @unique @map("order_number")
  customerId           String               @map("customer_id") @db.Uuid
  customer             User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  status               OrderStatus          @default(AWAITING_PAYMENT)
  currency             String               @db.VarChar(3)
  subtotal             Decimal              @db.Decimal(12, 2)
  shippingTotal        Decimal              @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal             Decimal              @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal        Decimal              @default(0) @map("discount_total") @db.Decimal(12, 2)
  promotionId          String?              @map("promotion_id") @db.Uuid
  promotion            Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionName        String?              @map("promotion_name")
  promotionDiscount    Decimal              @default(0) @map("promotion_discount") @db.Decimal(12, 2)
  total                Decimal              @db.Decimal(12, 2)
  recipientName        String               @map("recipient_name")
  contactEmail         String               @map("contact_email")
  contactPhone         String?              @map("contact_phone")
  addressLine1         String               @map("address_line1")
  addressLine2         String?              @map("address_line2")
  city                 String
  region               String
  postalCode           String               @map("postal_code")
  countryCode          String               @map("country_code") @db.VarChar(2)
  deliveryMethod       DeliveryMethod       @default(PICKUP) @map("delivery_method")
  deliveryDistanceKm   Decimal?             @map("delivery_distance_km") @db.Decimal(10, 3)
  customerLatitude     Decimal?             @map("customer_latitude") @db.Decimal(10, 7)
  customerLongitude    Decimal?             @map("customer_longitude") @db.Decimal(10, 7)
  reservationExpiresAt DateTime?            @map("reservation_expires_at") @db.Timestamptz(6)
  placedAt             DateTime             @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt               DateTime?            @map("paid_at") @db.Timestamptz(6)
  cancelledAt          DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  vendorOrders         VendorOrder[]
  installmentAgreements InstallmentAgreement[]
  items                OrderItem[]
  payments             Payment[]
  refunds              Refund[]
  couponRedemption     CouponRedemption?
  returns              ReturnRequest[]
  reviews              ProductReview[]
  statusHistory        OrderStatusHistory[]
  commissionEntries    CommissionLedger[]
  deliveryRequests     DeliveryRequest[]
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

model VendorOrder {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorId          String               @map("vendor_id") @db.Uuid
  vendor            Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status            OrderStatus          @default(AWAITING_PAYMENT)
  currency          String               @db.VarChar(3)
  subtotal          Decimal              @db.Decimal(12, 2)
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  commissionEntries CommissionLedger[]
  returns           ReturnRequest[]
  shipment          Shipment?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
  @@map("vendor_orders")
}

model OrderItem {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrderId String          @map("vendor_order_id") @db.Uuid
  vendorOrder   VendorOrder     @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  productId     String?         @map("product_id") @db.Uuid
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String          @map("product_name")
  productSlug   String          @map("product_slug")
  sku           String
  variantId     String?         @map("variant_id") @db.Uuid
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName   String?         @map("variant_name")
  imageKey      String?         @map("image_key")
  unitPrice     Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal         @map("line_total") @db.Decimal(12, 2)
  currency      String          @db.VarChar(3)
  returnItem    ReturnItem?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider    @default(LYNXPAY)
  attempt           Int
  status            PaymentStatus      @default(PENDING)
  amount            Decimal            @db.Decimal(12, 2)
  feeAmount         Decimal            @default(0) @map("fee_amount") @db.Decimal(12, 2)
  netAmount         Decimal            @default(0) @map("net_amount") @db.Decimal(12, 2)
  currency          String             @db.VarChar(3)
  paymentMethod     String?            @map("payment_method") @db.VarChar(32)
  customerPhone     String?            @map("customer_phone") @db.VarChar(20)
  idempotencyKey    String             @unique @map("idempotency_key") @db.VarChar(128)
  providerPaymentId String?            @unique @map("provider_payment_id") @db.VarChar(128)
  providerReference String?            @map("provider_reference") @db.VarChar(128)
  checkoutUrl       String?            @map("checkout_url") @db.Text
  failureCode       String?            @map("failure_code") @db.VarChar(64)
  failureMessage    String?            @map("failure_message") @db.Text
  initiatedAt       DateTime           @default(now()) @map("initiated_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  failedAt          DateTime?          @map("failed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  refunds           Refund[]
  ledgerEntries     CommissionLedger[]

  @@unique([orderId, attempt])
  @@index([orderId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id                String              @id @default(uuid()) @db.Uuid
  provider          PaymentProvider     @default(LYNXPAY)
  deliveryId        String              @map("delivery_id") @db.VarChar(128)
  eventType         String              @map("event_type") @db.VarChar(64)
  providerPaymentId String?             @map("provider_payment_id") @db.VarChar(128)
  externalId        String?             @map("external_id") @db.VarChar(128)
  status            PaymentStatus?
  outcome           PaymentEventOutcome
  payload           Json
  receivedAt        DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(6)
  errorMessage      String?             @map("error_message") @db.Text

  @@unique([provider, deliveryId])
  @@index([providerPaymentId])
  @@index([outcome, receivedAt])
  @@map("payment_events")
}

model Refund {
  id               String             @id @default(uuid()) @db.Uuid
  paymentId        String             @map("payment_id") @db.Uuid
  payment          Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  orderId          String             @map("order_id") @db.Uuid
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount           Decimal            @db.Decimal(12, 2)
  currency         String             @db.VarChar(3)
  reason           String             @db.VarChar(200)
  status           RefundStatus       @default(PENDING)
  providerRefundId String?            @unique @map("provider_refund_id") @db.VarChar(128)
  requestedById    String?            @map("requested_by_id") @db.Uuid
  requestedBy      User?              @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  failureMessage   String?            @map("failure_message") @db.Text
  processedAt      DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  ledgerEntries    CommissionLedger[]

  @@index([paymentId, status])
  @@index([orderId])
  @@map("refunds")
}

model CommissionRule {
  id            String             @id @default(uuid()) @db.Uuid
  version       String             @unique @db.VarChar(64)
  basisPoints   Int                @map("basis_points")
  description   String             @default("")
  effectiveFrom DateTime           @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  ledgerEntries CommissionLedger[]

  @@map("commission_rules")
}

model CommissionLedger {
  id               String              @id @default(uuid()) @db.Uuid
  paymentId        String?             @map("payment_id") @db.Uuid
  payment          Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundId         String?             @map("refund_id") @db.Uuid
  refund           Refund?             @relation(fields: [refundId], references: [id], onDelete: Restrict)
  orderId          String              @map("order_id") @db.Uuid
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrderId    String?             @map("vendor_order_id") @db.Uuid
  vendorOrder      VendorOrder?        @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  vendorId         String?             @map("vendor_id") @db.Uuid
  vendor           Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  commissionRuleId String?             @map("commission_rule_id") @db.Uuid
  commissionRule   CommissionRule?     @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  type             CommissionEntryType
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @db.VarChar(3)
  basisPoints      Int?                @map("basis_points")
  entryKey         String              @unique @map("entry_key") @db.VarChar(160)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([paymentId])
  @@index([vendorId, createdAt])
  @@index([type, createdAt])
  @@map("commission_ledger")
}

model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  vendorId       String       @map("vendor_id") @db.Uuid
  vendor         Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status         PayoutStatus @default(PENDING)
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @db.VarChar(3)
  reference      String?      @unique @db.VarChar(64)
  note           String?
  periodStart    DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime     @map("period_end") @db.Timestamptz(6)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdBy      User?        @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(6)
  reconciledAt   DateTime?    @map("reconciled_at") @db.Timestamptz(6)
  failureMessage String?      @map("failure_message") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("payouts")
}

model AccountToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AccountTokenPurpose
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_tokens")
}

// ── Phase 2: point of sale, cash sessions, and expenses ────────────────────────

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum SalePaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  OTHER
}

model Warehouse {
  id            String              @id @default(uuid()) @db.Uuid
  vendorId      String              @map("vendor_id") @db.Uuid
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name          String
  code          String
  address       String?
  isDefault     Boolean             @default(false) @map("is_default")
  isActive      Boolean             @default(true) @map("is_active")
  balances      InventoryBalance[]
  movements     InventoryMovement[]
  transfersFrom WarehouseTransfer[] @relation("TransferFrom")
  transfersTo   WarehouseTransfer[] @relation("TransferTo")
  installmentReservations InstallmentStockReservation[]
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, code])
  @@index([vendorId])
  @@map("warehouses")
}

model InventoryBalance {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("inventory_balances")
}

model PosRegister {
  id        String       @id @default(uuid()) @db.Uuid
  vendorId  String       @map("vendor_id") @db.Uuid
  vendor    Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  sessions  PosSession[]
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorId])
  @@map("pos_registers")
}

model PosSession {
  id           String           @id @default(uuid()) @db.Uuid
  vendorId     String           @map("vendor_id") @db.Uuid
  vendor       Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  registerId   String           @map("register_id") @db.Uuid
  register     PosRegister      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  status       PosSessionStatus @default(OPEN)
  currency     String           @default("TZS") @db.VarChar(3)
  openingFloat Decimal          @default(0) @map("opening_float") @db.Decimal(12, 2)
  expectedCash Decimal?         @map("expected_cash") @db.Decimal(12, 2)
  countedCash  Decimal?         @map("counted_cash") @db.Decimal(12, 2)
  openedById   String?          @map("opened_by_id") @db.Uuid
  openedBy     User?            @relation("PosSessionOpener", fields: [openedById], references: [id], onDelete: SetNull)
  closedById   String?          @map("closed_by_id") @db.Uuid
  closedBy     User?            @relation("PosSessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  openedAt     DateTime         @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime?        @map("closed_at") @db.Timestamptz(6)
  notes        String?
  sales        Sale[]

  @@index([vendorId, status])
  @@index([registerId])
  @@map("pos_sessions")
}

model Sale {
  id         String        @id @default(uuid()) @db.Uuid
  vendorId   String        @map("vendor_id") @db.Uuid
  vendor     Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  sessionId  String        @map("session_id") @db.Uuid
  session    PosSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  saleNumber String        @map("sale_number")
  currency   String        @default("TZS") @db.VarChar(3)
  subtotal   Decimal       @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  soldById   String?       @map("sold_by_id") @db.Uuid
  soldBy     User?         @relation("SaleSoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  soldAt     DateTime      @default(now()) @map("sold_at") @db.Timestamptz(6)
  items      SaleItem[]
  payments   SalePayment[]
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([vendorId, saleNumber])
  @@index([vendorId, soldAt])
  @@index([sessionId])
  @@map("sales")
}

model SaleItem {
  id          String          @id @default(uuid()) @db.Uuid
  saleId      String          @map("sale_id") @db.Uuid
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?         @map("product_id") @db.Uuid
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String          @map("product_name")
  variantId   String?         @map("variant_id") @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?         @map("variant_name")
  sku         String
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  unitCost    Decimal?        @map("unit_cost") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)
  currency    String          @db.VarChar(3)

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
  @@map("sale_items")
}

model SalePayment {
  id        String            @id @default(uuid()) @db.Uuid
  saleId    String            @map("sale_id") @db.Uuid
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    SalePaymentMethod
  amount    Decimal           @db.Decimal(12, 2)
  reference String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([saleId])
  @@map("sale_payments")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("TZS") @db.VarChar(3)
  spentAt     DateTime @default(now()) @map("spent_at") @db.Timestamptz(6)
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("ExpenseRecorder", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vendorId, spentAt])
  @@map("expenses")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  targetType String      @map("target_type")
  targetId   String?     @map("target_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Phase 3: Commerce ────────────────────────────────────────────────────────

/// A buyer's saved objects. Replaces the client-only wishlist prototype with a
/// per-account record, so it survives devices and service-worker cache resets.
model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("UserWishlist", fields: [userId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

/// Append-only record of every order status change, for the buyer timeline and
/// support investigations. Rows are never updated or deleted.
model OrderStatusHistory {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrderId String?      @map("vendor_order_id") @db.Uuid
  vendorOrder   VendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus  @map("to_status")
  actorId       String?      @map("actor_id") @db.Uuid
  actor         User?        @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId, createdAt])
  @@index([vendorOrderId, createdAt])
  @@map("order_status_history")
}

// ── Phase 3: Promotions ──────────────────────────────────────────────────────

enum CouponKind {
  PERCENT
  FIXED
}

/// A checkout discount code. Codes are marketplace-wide; the platform funds the
/// discount, so studio payouts still use each studio order's full subtotal.
model Coupon {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique
  description     String
  kind            CouponKind
  /// Percentage (0–100) for PERCENT, otherwise an amount in `currency`.
  value           Decimal            @db.Decimal(12, 2)
  currency        String             @default("TZS") @db.VarChar(3)
  minSubtotal     Decimal?           @map("min_subtotal") @db.Decimal(12, 2)
  maxRedemptions  Int?               @map("max_redemptions")
  redemptions     Int                @default(0)
  startsAt        DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?          @map("ends_at") @db.Timestamptz(6)
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  redemptionsList CouponRedemption[]

  @@index([isActive, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId   String   @unique @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("CouponRedeemer", fields: [userId], references: [id], onDelete: Restrict)
  code      String
  discount  Decimal  @db.Decimal(12, 2)
  currency  String   @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([couponId, createdAt])
  @@index([userId, createdAt])
  @@map("coupon_redemptions")
}

// ── Phase 3: Verified reviews ────────────────────────────────────────────────

/// One review per buyer per object. A review can only be written by a buyer who
/// has an object in an order that reached PAID or later, so ratings are tied to
/// a real purchase. Editing keeps the original purchase reference.
model ProductReview {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  orderId   String?  @map("order_id") @db.Uuid
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([productId, authorId])
  @@index([productId, createdAt])
  @@map("product_reviews")
}

// ── Phase 3: Returns ─────────────────────────────────────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnReason {
  DAMAGED
  NOT_AS_DESCRIBED
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

/// One customer-initiated return per studio order, reviewed by that studio.
/// Refunds stay out of scope: a completed return records the physical outcome.
model Shipment {
  id             String      @id @default(uuid()) @db.Uuid
  vendorOrderId  String      @unique @map("vendor_order_id") @db.Uuid
  vendorOrder    VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  vendorId       String      @map("vendor_id") @db.Uuid
  vendor         Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  carrier        String
  trackingNumber String      @map("tracking_number")
  trackingUrl    String?     @map("tracking_url")
  shippedAt      DateTime    @default(now()) @map("shipped_at") @db.Timestamptz(6)
  deliveredAt    DateTime?   @map("delivered_at") @db.Timestamptz(6)
  note           String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorId, createdAt])
  @@map("shipments")
}

model ReturnRequest {
  id            String       @id @default(uuid()) @db.Uuid
  returnNumber  String       @unique @map("return_number")
  orderId       String       @map("order_id") @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrderId String       @map("vendor_order_id") @db.Uuid
  vendorOrder   VendorOrder  @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  customerId    String       @map("customer_id") @db.Uuid
  customer      User         @relation("ReturnRequester", fields: [customerId], references: [id], onDelete: Restrict)
  status        ReturnStatus @default(REQUESTED)
  note          String?
  vendorNote    String?      @map("vendor_note")
  requestedAt   DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt     DateTime?    @map("decided_at") @db.Timestamptz(6)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  items         ReturnItem[]
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vendorOrderId, status])
  @@index([customerId, createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String        @id @default(uuid()) @db.Uuid
  returnId    String        @map("return_id") @db.Uuid
  return      ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String        @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  reason      ReturnReason
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("return_items")
}

// ── Phase 4: Shared Logistics Network ───────────────────────────────────────

/// A courier. Optionally linked to a user account so agents can sign in and
/// act on their own jobs. Independent agents have no user account.
model DeliveryAgent {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String?                 @unique @map("user_id") @db.Uuid
  user           User?                   @relation("DeliveryAgentUser", fields: [userId], references: [id], onDelete: SetNull)
  agentCode      String                  @unique @map("agent_code")
  name           String
  phone          String
  presence       AgentPresence           @default(OFFLINE)
  verification   AgentVerificationStatus @default(PENDING)
  rating         Decimal                 @default(5) @db.Decimal(3, 2)
  completedTrips Int                     @default(0) @map("completed_trips")
  latitude       Decimal?                @db.Decimal(10, 7)
  longitude      Decimal?                @db.Decimal(10, 7)
  vehicle        DeliveryVehicle?
  documents      AgentDocument[]
  serviceAreas   AgentServiceArea[]
  assignments    DeliveryAssignment[]
  currentJobs    DeliveryJob[]           @relation("DeliveryJobAgent")
  locations      DeliveryLocation[]
  earnings       AgentEarning[]
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([verification, presence])
  @@map("delivery_agents")
}

model DeliveryVehicle {
  id        String              @id @default(uuid()) @db.Uuid
  agentId   String              @unique @map("agent_id") @db.Uuid
  agent     DeliveryAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      DeliveryVehicleType
  plate     String
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("delivery_vehicles")
}

/// KYC / verification paperwork for an agent. Reviewed by an administrator.
model AgentDocument {
  id           String            @id @default(uuid()) @db.Uuid
  agentId      String            @map("agent_id") @db.Uuid
  agent        DeliveryAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type         AgentDocumentType
  storageKey   String            @map("storage_key")
  status       VerificationState @default(PENDING)
  reviewedById String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?             @relation("AgentDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agentId, status])
  @@map("agent_documents")
}

/// A geographic area an agent is willing to serve, used by the dispatch scorer.
model AgentServiceArea {
  id        String        @id @default(uuid()) @db.Uuid
  agentId   String        @map("agent_id") @db.Uuid
  agent     DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  label     String
  latitude  Decimal       @db.Decimal(10, 7)
  longitude Decimal       @db.Decimal(10, 7)
  radiusKm  Decimal       @map("radius_km") @db.Decimal(8, 3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agentId])
  @@map("agent_service_areas")
}

/// Configurable distance pricing. Market pricing is unresolved in
/// docs/01-product-vision.md; this row is the documented default.
model DeliveryPricingRule {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  currency   String   @db.VarChar(3)
  baseFee    Decimal  @map("base_fee") @db.Decimal(12, 2)
  perKmRate  Decimal  @map("per_km_rate") @db.Decimal(12, 2)
  minimumFee Decimal  @map("minimum_fee") @db.Decimal(12, 2)
  maximumFee Decimal? @map("maximum_fee") @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([currency, isActive])
  @@map("delivery_pricing_rules")
}

/// A request for delivery. Linked to an order for marketplace deliveries, or
/// to a business with no order for external delivery requests.
model DeliveryRequest {
  id               String                @id @default(uuid()) @db.Uuid
  requestNumber    String                @unique @map("request_number")
  /// Idempotency key for the external delivery request API.
  externalRef      String?               @unique @map("external_ref")
  orderId          String?               @map("order_id") @db.Uuid
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  businessId       String?               @map("business_id") @db.Uuid
  business         Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)
  requesterId      String                @map("requester_id") @db.Uuid
  requester        User                  @relation("DeliveryRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  pickupName       String                @map("pickup_name")
  pickupPhone      String?               @map("pickup_phone")
  pickupAddress    String                @map("pickup_address")
  pickupLatitude   Decimal               @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude  Decimal               @map("pickup_longitude") @db.Decimal(10, 7)
  dropoffName      String                @map("dropoff_name")
  dropoffPhone     String?               @map("dropoff_phone")
  dropoffAddress   String                @map("dropoff_address")
  dropoffLatitude  Decimal               @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude Decimal               @map("dropoff_longitude") @db.Decimal(10, 7)
  distanceKm       Decimal               @map("distance_km") @db.Decimal(10, 3)
  fee              Decimal               @db.Decimal(12, 2)
  currency         String                @db.VarChar(3)
  status           DeliveryRequestStatus @default(PENDING)
  /// PLATFORM or COMPANY. Company requests are created from a logistics workspace.
  source           String                @default("PLATFORM") @db.VarChar(16)
  companyId        String?               @map("company_id") @db.Uuid
  contractId       String?               @map("contract_id") @db.Uuid
  contract         LogisticsContract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  note             String?
  jobs             DeliveryJob[]
  opportunities    DeliveryOpportunity[]
  externalOrders   LogisticsExternalOrder[]
  optimizationSuggestions LogisticsOptimizationSuggestion[]
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([requesterId, createdAt])
  @@index([businessId, status])
  @@index([status, createdAt])
  @@map("delivery_requests")
}

/// One dispatchable unit of work for a request. Created when an agent is
/// assigned; the status column is the authoritative lifecycle state.
model DeliveryJob {
  id            String                  @id @default(uuid()) @db.Uuid
  jobNumber     String                  @unique @map("job_number")
  requestId     String                  @map("request_id") @db.Uuid
  request       DeliveryRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  agentId       String?                 @map("agent_id") @db.Uuid
  agent         DeliveryAgent?          @relation("DeliveryJobAgent", fields: [agentId], references: [id], onDelete: SetNull)
  companyId     String?                 @map("company_id") @db.Uuid
  contractId    String?                 @map("contract_id") @db.Uuid
  contract      LogisticsContract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Company driver assigned instead of a platform courier (legacy agentId stays null).
  driverMembershipId String?            @map("driver_membership_id") @db.Uuid
  driverMembership DriverCompanyMembership? @relation(fields: [driverMembershipId], references: [id], onDelete: SetNull)
  status        DeliveryJobStatus       @default(ASSIGNED)
  /// Hand-over code shown to the buyer and entered by the agent at the door.
  otpCode       String?                 @map("otp_code")
  otpExpiresAt  DateTime?               @map("otp_expires_at") @db.Timestamptz(6)
  assignedAt    DateTime                @default(now()) @map("assigned_at") @db.Timestamptz(6)
  acceptedAt    DateTime?               @map("accepted_at") @db.Timestamptz(6)
  pickedUpAt    DateTime?               @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt   DateTime?               @map("delivered_at") @db.Timestamptz(6)
  cancelledAt   DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  assignments   DeliveryAssignment[]
  statusHistory DeliveryStatusHistory[]
  locations     DeliveryLocation[]
  proofs        DeliveryProof[]
  earning       AgentEarning?
  commission    DeliveryCommission?
  shareUsages   FleetShareUsage[]
  hubHandovers  ParcelHubHandover[]
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([agentId, status])
  @@index([companyId, status])
  @@index([driverMembershipId, status])
  @@index([requestId])
  @@index([status, createdAt])
  @@map("delivery_jobs")
}

/// Assignment history. A job can be reassigned; the previous row is closed
/// with releasedAt rather than deleted.
model DeliveryAssignment {
  id         String        @id @default(uuid()) @db.Uuid
  jobId      String        @map("job_id") @db.Uuid
  job        DeliveryJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId    String?       @map("agent_id") @db.Uuid
  agent      DeliveryAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  driverMembershipId String? @map("driver_membership_id") @db.Uuid
  score      Decimal       @db.Decimal(6, 3)
  assignedAt DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  releasedAt DateTime?     @map("released_at") @db.Timestamptz(6)

  @@index([jobId, assignedAt])
  @@index([agentId, assignedAt])
  @@map("delivery_assignments")
}

/// Append-only lifecycle timeline. Written inside the transaction that moves
/// the job status so the timeline can never disagree with the job record.
model DeliveryStatusHistory {
  id         String             @id @default(uuid()) @db.Uuid
  jobId      String             @map("job_id") @db.Uuid
  job        DeliveryJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus DeliveryJobStatus? @map("from_status")
  toStatus   DeliveryJobStatus  @map("to_status")
  actorId    String?            @map("actor_id") @db.Uuid
  actor      User?              @relation("DeliveryStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobId, createdAt])
  @@map("delivery_status_history")
}

/// Courier location pings, used for real-time tracking instead of the old
/// client-side interpolation.
model DeliveryLocation {
  id         String        @id @default(uuid()) @db.Uuid
  jobId      String        @map("job_id") @db.Uuid
  job        DeliveryJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId    String        @map("agent_id") @db.Uuid
  agent      DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Restrict)
  latitude   Decimal       @db.Decimal(10, 7)
  longitude  Decimal       @db.Decimal(10, 7)
  heading    Decimal?      @db.Decimal(6, 2)
  recordedAt DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([jobId, recordedAt])
  @@index([agentId, recordedAt])
  @@map("delivery_locations")
}

/// Proof of hand-over: photo, OTP confirmation, or signature.
model DeliveryProof {
  id         String            @id @default(uuid()) @db.Uuid
  jobId      String            @map("job_id") @db.Uuid
  job        DeliveryJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type       DeliveryProofType
  storageKey String?           @map("storage_key")
  note       String?
  recordedAt DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([jobId, recordedAt])
  @@map("delivery_proofs")
}

/// Immutable agent earning row for a completed job.
model AgentEarning {
  id        String             @id @default(uuid()) @db.Uuid
  agentId   String             @map("agent_id") @db.Uuid
  agent     DeliveryAgent      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  jobId     String             @unique @map("job_id") @db.Uuid
  job       DeliveryJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount    Decimal            @db.Decimal(12, 2)
  currency  String             @db.VarChar(3)
  status    AgentEarningStatus @default(PENDING)
  paidAt    DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([agentId, status])
  @@map("agent_earnings")
}

/// Platform commission recorded against a delivery job.
model DeliveryCommission {
  id        String      @id @default(uuid()) @db.Uuid
  jobId     String      @unique @map("job_id") @db.Uuid
  job       DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  amount    Decimal     @db.Decimal(12, 2)
  currency  String      @db.VarChar(3)
  rateBps   Int         @map("rate_bps")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("delivery_commissions")
}

// ── Phase 5: B2B Wholesale Network ──────────────────────────────────────────

/// A supplier's bulk offer. Optional link to a retail product for reuse of
/// imagery/details; standalone listings are allowed for raw or made-to-order stock.
model WholesaleListing {
  id             String                 @id @default(uuid()) @db.Uuid
  listingNumber  String                 @unique @map("listing_number")
  vendorId       String                 @map("vendor_id") @db.Uuid
  vendor         Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  businessId     String?                @map("business_id") @db.Uuid
  business       Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  productId      String?                @map("product_id") @db.Uuid
  product        Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  title          String
  description    String                 @default("")
  sku            String
  currency       String                 @db.VarChar(3)
  unitPrice      Decimal                @map("unit_price") @db.Decimal(12, 2)
  minimumOrder   Int                    @map("minimum_order")
  stockAvailable Int                    @map("stock_available")
  leadTimeDays   Int                    @default(7) @map("lead_time_days")
  status         WholesaleListingStatus @default(DRAFT)
  publishedAt    DateTime?              @map("published_at") @db.Timestamptz(6)
  priceTiers     WholesalePriceTier[]
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, sku])
  @@index([status, publishedAt])
  @@index([vendorId, status])
  @@map("wholesale_listings")
}

/// Volume breaks. `maxQty` null means "and above".
model WholesalePriceTier {
  id        String           @id @default(uuid()) @db.Uuid
  listingId String           @map("listing_id") @db.Uuid
  listing   WholesaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  minQty    Int              @map("min_qty")
  maxQty    Int?             @map("max_qty")
  unitPrice Decimal          @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([listingId, minQty])
  @@index([listingId])
  @@map("wholesale_price_tiers")
}

/// A buyer business requests prices and terms from one supplier.
model Rfq {
  id               String              @id @default(uuid()) @db.Uuid
  rfqNumber        String              @unique @map("rfq_number")
  buyerBusinessId  String              @map("buyer_business_id") @db.Uuid
  buyerBusiness    Business            @relation("RfqBuyer", fields: [buyerBusinessId], references: [id], onDelete: Restrict)
  supplierVendorId String              @map("supplier_vendor_id") @db.Uuid
  supplierVendor   Vendor              @relation("RfqSupplier", fields: [supplierVendorId], references: [id], onDelete: Restrict)
  submittedById    String              @map("submitted_by_id") @db.Uuid
  submittedBy      User                @relation("RfqSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  status           RfqStatus           @default(DRAFT)
  currency         String              @db.VarChar(3)
  note             String?
  targetDate       DateTime?           @map("target_date") @db.Timestamptz(6)
  expiresAt        DateTime?           @map("expires_at") @db.Timestamptz(6)
  submittedAt      DateTime?           @map("submitted_at") @db.Timestamptz(6)
  items            RfqItem[]
  quotations       SupplierQuotation[]
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerBusinessId, status])
  @@index([supplierVendorId, status])
  @@map("rfqs")
}

model RfqItem {
  id             String          @id @default(uuid()) @db.Uuid
  rfqId          String          @map("rfq_id") @db.Uuid
  rfq            Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  listingId      String?         @map("listing_id") @db.Uuid
  productName    String          @map("product_name")
  sku            String?
  quantity       Int
  unit           String          @default("each")
  targetPrice    Decimal?        @map("target_price") @db.Decimal(12, 2)
  note           String?
  quotationItems QuotationItem[]
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([rfqId])
  @@map("rfq_items")
}

/// A supplier's priced response to a buyer RFQ.
model SupplierQuotation {
  id               String                  @id @default(uuid()) @db.Uuid
  quotationNumber  String                  @unique @map("quotation_number")
  rfqId            String                  @map("rfq_id") @db.Uuid
  rfq              Rfq                     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierVendorId String                  @map("supplier_vendor_id") @db.Uuid
  supplierVendor   Vendor                  @relation(fields: [supplierVendorId], references: [id], onDelete: Restrict)
  businessId       String?                 @map("business_id") @db.Uuid
  status           QuotationStatus         @default(DRAFT)
  currency         String                  @db.VarChar(3)
  subtotal         Decimal                 @db.Decimal(12, 2)
  note             String?
  validUntil       DateTime?               @map("valid_until") @db.Timestamptz(6)
  sentAt           DateTime?               @map("sent_at") @db.Timestamptz(6)
  acceptedAt       DateTime?               @map("accepted_at") @db.Timestamptz(6)
  items            QuotationItem[]
  purchaseOrders   BusinessPurchaseOrder[]
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([rfqId])
  @@index([supplierVendorId, status])
  @@map("supplier_quotations")
}

model QuotationItem {
  id          String            @id @default(uuid()) @db.Uuid
  quotationId String            @map("quotation_id") @db.Uuid
  quotation   SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItemId   String            @map("rfq_item_id") @db.Uuid
  rfqItem     RfqItem           @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)
  productName String            @map("product_name")
  sku         String?
  quantity    Int
  unitPrice   Decimal           @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal           @map("line_total") @db.Decimal(12, 2)
  currency    String            @db.VarChar(3)
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([quotationId, rfqItemId])
  @@map("quotation_items")
}

/// A business's bulk order, normally created from an accepted quotation.
model BusinessPurchaseOrder {
  id               String                      @id @default(uuid()) @db.Uuid
  poNumber         String                      @unique @map("po_number")
  businessId       String                      @map("business_id") @db.Uuid
  business         Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierVendorId String                      @map("supplier_vendor_id") @db.Uuid
  supplierVendor   Vendor                      @relation(fields: [supplierVendorId], references: [id], onDelete: Restrict)
  quotationId      String?                     @map("quotation_id") @db.Uuid
  quotation        SupplierQuotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  submittedById    String                      @map("submitted_by_id") @db.Uuid
  submittedBy      User                        @relation("PurchaseOrderSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  status           PurchaseOrderStatus         @default(DRAFT)
  currency         String                      @db.VarChar(3)
  subtotal         Decimal                     @db.Decimal(12, 2)
  taxTotal         Decimal                     @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal    Decimal                     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  total            Decimal                     @db.Decimal(12, 2)
  note             String?
  orderedAt        DateTime?                   @map("ordered_at") @db.Timestamptz(6)
  confirmedAt      DateTime?                   @map("confirmed_at") @db.Timestamptz(6)
  receivedAt       DateTime?                   @map("received_at") @db.Timestamptz(6)
  cancelledAt      DateTime?                   @map("cancelled_at") @db.Timestamptz(6)
  items            BusinessPurchaseOrderItem[]
  invoices         BusinessInvoice[]
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([businessId, status])
  @@index([supplierVendorId, status])
  @@map("business_purchase_orders")
}

model BusinessPurchaseOrderItem {
  id               String                @id @default(uuid()) @db.Uuid
  purchaseOrderId  String                @map("purchase_order_id") @db.Uuid
  purchaseOrder    BusinessPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  listingId        String?               @map("listing_id") @db.Uuid
  productName      String                @map("product_name")
  sku              String?
  quantity         Int
  receivedQuantity Int                   @default(0) @map("received_quantity")
  unitPrice        Decimal               @map("unit_price") @db.Decimal(12, 2)
  lineTotal        Decimal               @map("line_total") @db.Decimal(12, 2)
  currency         String                @db.VarChar(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([purchaseOrderId])
  @@map("business_purchase_order_items")
}

/// Immutable invoice issued for a purchase order. Payment is manual until a
/// business payment policy is chosen in docs/01-product-vision.md.
model BusinessInvoice {
  id               String                @id @default(uuid()) @db.Uuid
  invoiceNumber    String                @unique @map("invoice_number")
  purchaseOrderId  String                @map("purchase_order_id") @db.Uuid
  purchaseOrder    BusinessPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  businessId       String                @map("business_id") @db.Uuid
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierVendorId String                @map("supplier_vendor_id") @db.Uuid
  supplierVendor   Vendor                @relation(fields: [supplierVendorId], references: [id], onDelete: Restrict)
  status           InvoiceStatus         @default(DRAFT)
  currency         String                @db.VarChar(3)
  subtotal         Decimal               @db.Decimal(12, 2)
  taxTotal         Decimal               @default(0) @map("tax_total") @db.Decimal(12, 2)
  total            Decimal               @db.Decimal(12, 2)
  amountPaid       Decimal               @default(0) @map("amount_paid") @db.Decimal(12, 2)
  note             String?
  dueAt            DateTime?             @map("due_at") @db.Timestamptz(6)
  issuedAt         DateTime?             @map("issued_at") @db.Timestamptz(6)
  paidAt           DateTime?             @map("paid_at") @db.Timestamptz(6)
  items            BusinessInvoiceItem[]
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([businessId, status])
  @@index([supplierVendorId, status])
  @@map("business_invoices")
}

model BusinessInvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  invoice     BusinessInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(12, 2)
  currency    String          @db.VarChar(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("business_invoice_items")
}

// ── Phase 6: Buyer ↔ studio messaging ────────────────────────────────────────

/// One thread per buyer/studio pair. The product is optional context from the
/// page where the conversation started and is cleared if that listing is removed.
model Chat {
  id            String        @id @default(uuid()) @db.Uuid
  buyerId       String        @map("buyer_id") @db.Uuid
  buyer         User          @relation("BuyerChats", fields: [buyerId], references: [id], onDelete: Cascade)
  vendorId      String        @map("vendor_id") @db.Uuid
  vendor        Vendor        @relation("VendorChats", fields: [vendorId], references: [id], onDelete: Cascade)
  productId     String?       @map("product_id") @db.Uuid
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime      @default(now()) @map("last_message_at") @db.Timestamptz(6)
  messages      ChatMessage[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([buyerId, vendorId])
  @@index([buyerId, lastMessageAt])
  @@index([vendorId, lastMessageAt])
  @@map("chats")
}

model ChatMessage {
  id        String    @id @default(uuid()) @db.Uuid
  chatId    String    @map("chat_id") @db.Uuid
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String    @map("sender_id") @db.Uuid
  sender    User      @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String    @db.Text
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}

/// Vendor-scoped CRM record for a buyer. Aggregates are derived from paid
/// orders; this table stores the studio's own note and segmentation.
model Customer {
  id        String          @id @default(uuid()) @db.Uuid
  vendorId  String          @map("vendor_id") @db.Uuid
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation("CustomerUser", fields: [userId], references: [id], onDelete: Cascade)
  segment   CustomerSegment @default(NEW)
  note      String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, userId])
  @@index([vendorId, segment])
  @@map("customers")
}

model LoyaltyAccount {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @unique @map("user_id") @db.Uuid
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance  Int                   @default(0) @map("points_balance")
  lifetimePoints Int                   @default(0) @map("lifetime_points")
  tier           LoyaltyTier           @default(BRONZE)
  transactions   LoyaltyTransaction[]
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id            String                  @id @default(uuid()) @db.Uuid
  accountId     String                  @map("account_id") @db.Uuid
  account       LoyaltyAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          LoyaltyTransactionType
  points        Int
  balanceAfter  Int                     @map("balance_after")
  referenceType String?                 @map("reference_type") @db.VarChar(40)
  referenceId   String?                 @map("reference_id") @db.VarChar(64)
  description   String
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([referenceType, referenceId, type])
  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

/// Admin-managed plan. `priceMonthly` is charged for each seat above
/// `includedSeats`, up to `seatLimit`.
model SubscriptionPlan {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique
  name          String
  description   String               @default("")
  priceMonthly  Decimal              @map("price_monthly") @db.Decimal(12, 2)
  currency      String               @default("TZS") @db.VarChar(3)
  includedSeats Int                  @default(1) @map("included_seats")
  seatLimit     Int                  @default(10) @map("seat_limit")
  features      Json                 @default("[]")
  status        SubscriptionPlanStatus @default(DRAFT)
  sortOrder     Int                  @default(0) @map("sort_order")
  subscriptions BusinessSubscription[]
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, sortOrder])
  @@map("subscription_plans")
}

model BusinessSubscription {
  id                String                     @id @default(uuid()) @db.Uuid
  businessId        String                     @unique @map("business_id") @db.Uuid
  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId            String                     @map("plan_id") @db.Uuid
  plan              SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  status            BusinessSubscriptionStatus @default(TRIALING)
  seats             Int                        @default(1)
  currentPeriodStart DateTime                  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd  DateTime                   @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt       DateTime?                  @map("trial_ends_at") @db.Timestamptz(6)
  canceledAt        DateTime?                  @map("canceled_at") @db.Timestamptz(6)
  invoices          SubscriptionInvoice[]
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([planId, status])
  @@index([currentPeriodEnd])
  @@map("business_subscriptions")
}

model SubscriptionInvoice {
  id             String                   @id @default(uuid()) @db.Uuid
  invoiceNumber  String                   @unique @map("invoice_number")
  subscriptionId String                   @map("subscription_id") @db.Uuid
  subscription   BusinessSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status         SubscriptionInvoiceStatus @default(DRAFT)
  currency       String                   @default("TZS") @db.VarChar(3)
  subtotal       Decimal                  @db.Decimal(12, 2)
  taxTotal       Decimal                  @default(0) @map("tax_total") @db.Decimal(12, 2)
  total          Decimal                  @db.Decimal(12, 2)
  amountPaid     Decimal                  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  periodStart    DateTime                 @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime                 @map("period_end") @db.Timestamptz(6)
  issuedAt       DateTime?                @map("issued_at") @db.Timestamptz(6)
  dueAt          DateTime?                @map("due_at") @db.Timestamptz(6)
  paidAt         DateTime?                @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([subscriptionId, status])
  @@map("subscription_invoices")
}

/// A single-use recovery code. Only the SHA-256 hash is stored.
model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, usedAt])
  @@map("backup_codes")
}

/// A short-lived phone verification challenge. Only the SHA-256 hash is stored.
model PhoneVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String    @db.VarChar(24)
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, phone, createdAt])
  @@map("phone_verifications")
}

/// A successful credentials sign-in. Device and location are derived from the
/// request at sign-in time; no client-supplied history is trusted.
model SignInEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  device     String   @db.VarChar(120)
  location   String   @db.VarChar(160)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  method     String   @db.VarChar(32)
  newDevice  Boolean  @default(false) @map("new_device")

  @@index([userId, occurredAt])
  @@index([userId, device])
  @@map("sign_in_events")
}

enum InsightType {
  LOW_STOCK
  REVENUE_TREND
  INVENTORY_IMBALANCE
  CUSTOMER_RETENTION
  RECOMMENDED_RESTOCK
}

enum InsightSeverity {
  INFO
  OPPORTUNITY
  WARNING
}

enum RecommendationSurface {
  HOME
  CATALOG
  ACCOUNT
}

/// Rule-based snapshot generated from first-party business data. No raw model
/// output is stored and no external inference provider is required.
model BusinessAiInsight {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type           InsightType
  severity       InsightSeverity @default(INFO)
  title          String          @db.VarChar(160)
  summary        String          @db.VarChar(600)
  recommendation String          @db.VarChar(600)
  confidence     Int             @default(80)
  evidence       Json            @default("{}")
  modelVersion   String          @default("configurable-rules-v1") @map("model_version") @db.VarChar(64)
  generatedAt    DateTime        @default(now()) @map("generated_at") @db.Timestamptz(6)
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId, generatedAt])
  @@map("business_ai_insights")
}

/// Persisted buyer-facing recommendations so the same suggestion can be
/// explained, measured, and dismissed without recomputing on every render.
model AiRecommendationHistory {
  id           String                @id @default(uuid()) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String                @map("product_id") @db.Uuid
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  surface      RecommendationSurface @default(CATALOG)
  score        Decimal?              @db.Decimal(6, 3)
  reason       String                @db.VarChar(300)
  modelVersion String                @default("configurable-rules-v1") @map("model_version") @db.VarChar(64)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  dismissedAt  DateTime?             @map("dismissed_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([productId])
  @@map("ai_recommendation_history")
}

/// Phase 7 rollout switch. Keys are stable identifiers; mutations write an
/// outbox event so downstream consumers can react to flag changes.
model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  description String   @db.VarChar(600)
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enabled, key])
  @@map("feature_flags")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

/// Transactional outbox entry. Producers insert this in the same transaction as
/// their domain write; the dispatcher publishes it to in-process handlers.
model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  eventType     String            @map("event_type") @db.VarChar(120)
  aggregateType String            @map("aggregate_type") @db.VarChar(80)
  aggregateId   String?           @map("aggregate_id") @db.VarChar(120)
  payload       Json              @default("{}")
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(6)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([eventType, createdAt])
  @@map("outbox_events")
}

// ── Phase 7: Services marketplace ──────────────────────────────────────────

enum ServiceListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ServiceBookingStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A bookable service offered by a verified vendor (haircut, repair, consultation, etc.).
model ServiceListing {
  id             String               @id @default(uuid()) @db.Uuid
  listingNumber  String               @unique @map("listing_number")
  vendorId       String               @map("vendor_id") @db.Uuid
  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  businessId     String?              @map("business_id") @db.Uuid
  business       Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  title          String
  description    String               @default("")
  categoryId     String?              @map("category_id") @db.Uuid
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currency       String               @default("TZS") @db.VarChar(3)
  unitPrice      Decimal              @map("unit_price") @db.Decimal(12, 2)
  durationMinutes Int                 @map("duration_minutes")
  location       String               @default("")
  status         ServiceListingStatus @default(DRAFT)
  publishedAt    DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings       ServiceBooking[]

  @@index([vendorId, status])
  @@index([status, publishedAt])
  @@map("service_listings")
}

/// A booking for a service listing, created by a buyer.
model ServiceBooking {
  id             String              @id @default(uuid()) @db.Uuid
  bookingNumber   String             @unique @map("booking_number")
  serviceId       String              @map("service_id") @db.Uuid
  service         ServiceListing      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  buyerId         String              @map("buyer_id") @db.Uuid
  buyer           User                @relation("ServiceBookingBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  vendorId        String              @map("vendor_id") @db.Uuid
  vendor          Vendor              @relation("ServiceBookings", fields: [vendorId], references: [id], onDelete: Cascade)
  currency        String              @default("TZS") @db.VarChar(3)
  unitPrice       Decimal             @map("unit_price") @db.Decimal(12, 2)
  scheduledAt     DateTime            @map("scheduled_at") @db.Timestamptz(6)
  status          ServiceBookingStatus @default(REQUESTED)
  note            String?             @db.Text
  confirmedAt     DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([serviceId, status])
  @@index([buyerId, createdAt])
  @@index([vendorId, status])
  @@map("service_bookings")
}

// ── Phase 7: Group / community buying ──────────────────────────────────────

enum GroupBuyStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  EXPIRED
  CANCELLED
}

/// A community buying campaign that offers progressive discounts as more buyers join.
model GroupBuyCampaign {
  id              String        @id @default(uuid()) @db.Uuid
  campaignNumber  String        @unique @map("campaign_number")
  vendorId        String        @map("vendor_id") @db.Uuid
  vendor          Vendor        @relation("GroupBuyCampaigns", fields: [vendorId], references: [id], onDelete: Cascade)
  businessId      String?       @map("business_id") @db.Uuid
  business        Business?     @relation("GroupBuyCampaigns", fields: [businessId], references: [id], onDelete: SetNull)
  productId       String?       @map("product_id") @db.Uuid
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  title           String
  description     String        @default("")
  currency        String        @default("TZS") @db.VarChar(3)
  basePrice       Decimal       @map("base_price") @db.Decimal(12, 2)
  targetQuantity  Int           @map("target_quantity")
  maxQuantity     Int?          @map("max_quantity")
  status          GroupBuyStatus @default(DRAFT)
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(6)
  fundedAt        DateTime?     @map("funded_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tiers           GroupBuyTier[]
  participations  GroupBuyParticipation[]

  @@index([vendorId, status])
  @@index([status, endsAt])
  @@map("group_buy_campaigns")
}

/// Volume-based discount tier within a campaign. Applied when cumulative
/// participation reaches the tier threshold.
model GroupBuyTier {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  campaign      GroupBuyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  minQuantity   Int      @map("min_quantity")
  maxQuantity   Int?     @map("max_quantity")
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([campaignId, minQuantity])
  @@map("group_buy_tiers")
}

/// A buyer's participation in a group buy campaign. Quantity and commitment are immutable after the campaign funds.
model GroupBuyParticipation {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  campaign      GroupBuyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  buyerId       String   @map("buyer_id") @db.Uuid
  buyer         User     @relation("GroupBuyParticipations", fields: [buyerId], references: [id], onDelete: Cascade)
  quantity      Int
  currency      String   @default("TZS") @db.VarChar(3)
  reservedPrice Decimal  @map("reserved_price") @db.Decimal(12, 2)
  status        String   @default("JOINED") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([campaignId, buyerId])
  @@index([campaignId, createdAt])
  @@index([buyerId, createdAt])
  @@map("group_buy_participations")
}

// ── Phase 7: Regional logistics network ────────────────────────────────────

enum CorridorStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// A regional delivery corridor connecting two or more business branches or hubs.
model RegionalCorridor {
  id              String         @id @default(uuid()) @db.Uuid
  corridorCode    String         @unique @map("corridor_code")
  name            String
  description     String         @default("")
  originBranchId  String         @map("origin_branch_id") @db.Uuid
  originBranch    BusinessBranch @relation("CorridorOrigin", fields: [originBranchId], references: [id], onDelete: Cascade)
  destBranchId    String         @map("dest_branch_id") @db.Uuid
  destBranch      BusinessBranch @relation("CorridorDestination", fields: [destBranchId], references: [id], onDelete: Cascade)
  currency        String         @default("TZS") @db.VarChar(3)
  baseFee         Decimal        @map("base_fee") @db.Decimal(12, 2)
  perKmFee        Decimal        @map("per_km_fee") @db.Decimal(12, 2)
  estimatedKm     Int            @map("estimated_km")
  estimatedHours  Int            @map("estimated_hours")
  status          CorridorStatus @default(DRAFT)
  activatedAt     DateTime?      @map("activated_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  stops           CorridorStop[]

  @@index([status, originBranchId])
  @@index([status, destBranchId])
  @@map("regional_corridors")
}

/// An intermediate stop along a regional corridor.
model CorridorStop {
  id            String   @id @default(uuid()) @db.Uuid
  corridorId    String   @map("corridor_id") @db.Uuid
  corridor      RegionalCorridor @relation(fields: [corridorId], references: [id], onDelete: Cascade)
  branchId      String   @map("branch_id") @db.Uuid
  branch        BusinessBranch @relation("CorridorStops", fields: [branchId], references: [id], onDelete: Cascade)
  stopOrder     Int      @map("stop_order")
  label         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([corridorId, stopOrder])
  @@map("corridor_stops")
}

// ── Phase 8: Trust, verification and operations ─────────────────────────────

enum VerificationDocumentType {
  BUSINESS_REGISTRATION
  TAX_ID
  ID_DOCUMENT
  BANK_STATEMENT
  OTHER
}

enum VerificationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  INFO
  WARNING
  ERROR
}

/// A KYC document submitted by a business for administrator review.
model BusinessVerificationDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  businessId   String                   @map("business_id") @db.Uuid
  documentType VerificationDocumentType @map("document_type")
  reference    String                   @db.VarChar(160)
  storageKey   String                   @map("storage_key") @db.VarChar(255)
  status       VerificationReviewStatus @default(PENDING)
  reviewNote   String?                  @map("review_note") @db.Text
  reviewedById String?                  @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?                @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([businessId, status])
  @@index([status, createdAt])
  @@map("business_verification_documents")
}

/// Append-only record of every KYC decision.
model BusinessVerificationReview {
  id         String                   @id @default(uuid()) @db.Uuid
  businessId String                   @map("business_id") @db.Uuid
  documentId String?                  @map("document_id") @db.Uuid
  reviewerId String                   @map("reviewer_id") @db.Uuid
  decision   VerificationReviewStatus
  note       String                   @default("") @db.Text
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([businessId, createdAt])
  @@map("business_verification_reviews")
}

/// A buyer-initiated dispute about one of their vendor orders.
model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  disputeNumber  String        @unique @map("dispute_number")
  orderId        String        @map("order_id") @db.Uuid
  vendorOrderId  String        @map("vendor_order_id") @db.Uuid
  buyerId        String        @map("buyer_id") @db.Uuid
  vendorId       String        @map("vendor_id") @db.Uuid
  reason         String        @db.VarChar(160)
  description    String        @db.Text
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @map("resolution_note") @db.Text
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerId, createdAt])
  @@index([vendorId, status])
  @@index([status, createdAt])
  @@map("disputes")
}

/// Conversation attached to a dispute; buyers and administrators can post.
model DisputeMessage {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

/// One idempotent reconciliation sweep over the payment and ledger tables.
model ReconciliationRun {
  id            String                 @id @default(uuid()) @db.Uuid
  runNumber     String                 @unique @map("run_number")
  status        ReconciliationRunStatus @default(RUNNING)
  checkedCount  Int                    @default(0) @map("checked_count")
  findingCount  Int                    @default(0) @map("finding_count")
  initiatedById String?                @map("initiated_by_id") @db.Uuid
  finishedAt    DateTime?              @map("finished_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("reconciliation_runs")
}

/// A single mismatch found by a reconciliation sweep.
model ReconciliationFinding {
  id        String          @id @default(uuid()) @db.Uuid
  runId     String          @map("run_id") @db.Uuid
  paymentId String?         @map("payment_id") @db.Uuid
  severity  FindingSeverity
  code      String          @db.VarChar(80)
  message   String          @db.Text
  expected  String?         @db.VarChar(80)
  actual    String?         @db.VarChar(80)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([runId, severity])
  @@map("reconciliation_findings")
}

// ── Phase 9 L1: Logistics Business Network — company identity ───────────────

enum LogisticsCompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LogisticsMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// A first-class logistics business operating its own fleet and merchant clients.
model LogisticsCompany {
  id                 String                 @id @default(uuid()) @db.Uuid
  companyCode        String                 @unique @map("company_code")
  name               String
  slug               String                 @unique
  registrationNumber String?                @map("registration_number") @db.VarChar(80)
  description        String?                @db.Text
  contactPhone       String?                @map("contact_phone") @db.VarChar(40)
  contactEmail       String?                @map("contact_email") @db.VarChar(160)
  address            String?                @db.VarChar(300)
  city               String?                @db.VarChar(120)
  countryCode        String                 @default("TZ") @map("country_code") @db.VarChar(2)
  latitude           Decimal?               @db.Decimal(10, 7)
  longitude          Decimal?               @db.Decimal(10, 7)
  status             LogisticsCompanyStatus @default(PENDING)
  businessId         String?                @map("business_id") @db.Uuid
  plan               String                 @default("starter") @db.VarChar(40)
  settingsJson       Json?                  @map("settings_json")
  submittedAt        DateTime?              @map("submitted_at") @db.Timestamptz(6)
  reviewedById       String?                @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason    String?                @map("rejection_reason") @db.Text
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  members            LogisticsCompanyMember[]
  roles              LogisticsCompanyRole[]
  branches           LogisticsBranch[]
  settings           LogisticsCompanySettings?
  fleets             LogisticsFleet[]
  vehicles           LogisticsVehicle[]
  driverMemberships  DriverCompanyMembership[]
  clientRelationships CompanyClientRelationship[]
  contracts          LogisticsContract[]
  invoices           LogisticsInvoice[]
  earnings           DriverEarning[]
  payouts            DriverPayout[]
  expenses           LogisticsExpense[]
  settlements        LogisticsSettlement[]
  opportunities      DeliveryOpportunity[] @relation("OpportunityOfferedTo")
  offerScores        LogisticsCompanyOfferScore[]
  referrals          PartnerReferral[]
  rewards            PartnerReward[]
  apiKeys            LogisticsApiKey[]
  webhookEndpoints   LogisticsWebhookEndpoint[]
  externalStores     LogisticsExternalStore[]
  fleetShareOffers   FleetShareAgreement[] @relation("FleetShareOwner")
  fleetShareAgreements FleetShareAgreement[] @relation("FleetSharePartner")
  parcelHubs         ParcelHub[]
  optimizationSuggestions LogisticsOptimizationSuggestion[]

  @@index([status, createdAt])
  @@map("logistics_companies")
}

/// A platform user's membership in a logistics company. Ownership is never stored on User.
model LogisticsCompanyMember {
  id          String                 @id @default(uuid()) @db.Uuid
  companyId   String                 @map("company_id") @db.Uuid
  company     LogisticsCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String                 @map("user_id") @db.Uuid
  status      LogisticsMemberStatus @default(INVITED)
  invitedById String?                @map("invited_by_id") @db.Uuid
  joinedAt    DateTime?              @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       LogisticsMemberRole[]

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@map("logistics_company_members")
}

/// Company-specific role. Permission keys come from the shared Permission table.
model LogisticsCompanyRole {
  id          String                    @id @default(uuid()) @db.Uuid
  companyId   String                    @map("company_id") @db.Uuid
  company     LogisticsCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean                   @default(false) @map("is_system")
  description String?                   @db.VarChar(300)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  members     LogisticsMemberRole[]
  permissions LogisticsRolePermission[]

  @@unique([companyId, name])
  @@map("logistics_company_roles")
}

model LogisticsMemberRole {
  memberId String               @map("member_id") @db.Uuid
  member   LogisticsCompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String               @map("role_id") @db.Uuid
  role     LogisticsCompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("logistics_member_roles")
}

model LogisticsRolePermission {
  roleId       String               @map("role_id") @db.Uuid
  role         LogisticsCompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String               @map("permission_id") @db.Uuid
  permission   Permission           @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("logistics_role_permissions")
}

/// A physical operating location of a logistics company.
model LogisticsBranch {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  company     LogisticsCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  branchCode  String   @map("branch_code") @db.VarChar(40)
  address     String?  @db.VarChar(300)
  city        String?  @db.VarChar(120)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isPrimary   Boolean  @default(false) @map("is_primary")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, branchCode])
  @@index([companyId, isActive])
  @@map("logistics_branches")
}

/// Company-wide operational preferences. One row per company.
model LogisticsCompanySettings {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @unique @map("company_id") @db.Uuid
  company              LogisticsCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency             String   @default("TZS") @db.VarChar(3)
  timezone             String   @default("Africa/Dar_es_Salaam") @db.VarChar(64)
  notificationEmail    String?  @map("notification_email") @db.VarChar(160)
  defaultServiceRadius Decimal  @default(15) @map("default_service_radius") @db.Decimal(8, 3)
  settingsJson         Json?    @map("settings_json")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("logistics_company_settings")
}

// ── Phase 9 L3: fleet, vehicles and driver operations ───────────────────────

enum LogisticsVehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  TRUCK
}

enum VehicleOwnership {
  OWNED
  LEASED
  RENTED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  RETIRED
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  INSPECTION
  OTHER
}

enum DriverProfileStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum DriverMembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

model LogisticsFleet {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  company   LogisticsCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?           @map("branch_id") @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicles  LogisticsVehicle[]

  @@unique([companyId, name])
  @@map("logistics_fleets")
}

model LogisticsVehicle {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  company           LogisticsCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fleetId           String?             @map("fleet_id") @db.Uuid
  fleet             LogisticsFleet?     @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  plate             String              @db.VarChar(40)
  type              LogisticsVehicleType
  make              String?             @db.VarChar(80)
  model             String?             @db.VarChar(80)
  capacityKg        Decimal?            @map("capacity_kg") @db.Decimal(10, 2)
  ownership         VehicleOwnership    @default(OWNED)
  leaseProvider     String?             @map("lease_provider") @db.VarChar(160)
  status            VehicleStatus       @default(ACTIVE)
  insuranceExpiresAt DateTime?          @map("insurance_expires_at") @db.Timestamptz(6)
  inspectionExpiresAt DateTime?         @map("inspection_expires_at") @db.Timestamptz(6)
  acquiredAt        DateTime?           @map("acquired_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents         VehicleDocument[]
  maintenance       VehicleMaintenance[]
  assignments       DriverVehicleAssignment[]
  shareLinks        FleetShareVehicle[]
  shareUsages       FleetShareUsage[]

  @@unique([companyId, plate])
  @@index([companyId, status])
  @@map("logistics_vehicles")
}

model VehicleDocument {
  id           String               @id @default(uuid()) @db.Uuid
  vehicleId    String               @map("vehicle_id") @db.Uuid
  vehicle      LogisticsVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         VehicleDocumentType
  reference    String?              @db.VarChar(160)
  storageKey   String               @map("storage_key") @db.VarChar(255)
  expiresAt    DateTime?            @map("expires_at") @db.Timestamptz(6)
  status       VerificationState    @default(PENDING)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vehicleId, type])
  @@map("vehicle_documents")
}

model VehicleMaintenance {
  id          String           @id @default(uuid()) @db.Uuid
  vehicleId   String           @map("vehicle_id") @db.Uuid
  vehicle     LogisticsVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  performedAt DateTime         @map("performed_at") @db.Timestamptz(6)
  odometerKm  Int?             @map("odometer_km")
  cost        Decimal          @db.Decimal(12, 2)
  currency    String           @default("TZS") @db.VarChar(3)
  description String           @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vehicleId, performedAt])
  @@map("vehicle_maintenance")
}

/// Driver identity is independent of company ownership. A platform user may have
/// one profile; a legacy DeliveryAgent may be linked for migration.
model DriverProfile {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String?                 @unique @map("user_id") @db.Uuid
  deliveryAgentId String?                @unique @map("delivery_agent_id") @db.Uuid
  fullName       String                  @map("full_name")
  phone          String?                 @db.VarChar(40)
  licenseNumber  String?                 @map("license_number") @db.VarChar(80)
  licenseExpiresAt DateTime?             @map("license_expires_at") @db.Timestamptz(6)
  status         DriverProfileStatus     @default(ACTIVE)
  rating         Decimal                 @default(5) @db.Decimal(3, 2)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    DriverCompanyMembership[]

  @@index([status])
  @@map("driver_profiles")
}

/// The only company ownership relation for a driver.
model DriverCompanyMembership {
  id            String                  @id @default(uuid()) @db.Uuid
  companyId     String                  @map("company_id") @db.Uuid
  company       LogisticsCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId      String                  @map("driver_id") @db.Uuid
  driver        DriverProfile           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status        DriverMembershipStatus  @default(ACTIVE)
  joinedAt      DateTime                @default(now()) @map("joined_at") @db.Timestamptz(6)
  endedAt       DateTime?               @map("ended_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  employment    DriverEmploymentRecord?
  schedules     DriverSchedule[]
  assignments   DriverVehicleAssignment[]
  jobs          DeliveryJob[]
  compensationRules DriverCompensationRule[]
  earnings      DriverEarning[]
  payouts       DriverPayout[]

  @@unique([companyId, driverId])
  @@index([companyId, status])
  @@map("driver_company_memberships")
}

model DriverEmploymentRecord {
  id           String                  @id @default(uuid()) @db.Uuid
  membershipId String                  @unique @map("membership_id") @db.Uuid
  membership   DriverCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type         EmploymentType
  startDate    DateTime                @map("start_date") @db.Timestamptz(6)
  endDate      DateTime?               @map("end_date") @db.Timestamptz(6)
  mode         String                  @db.VarChar(40)
  amount       Decimal?                @db.Decimal(12, 2)
  rateBps      Int?                    @map("rate_bps")
  notes        String?                 @db.Text
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("driver_employment_records")
}

model DriverSchedule {
  id          String                  @id @default(uuid()) @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  membership  DriverCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  dayOfWeek   Int                     @map("day_of_week")
  startTime   String                  @map("start_time") @db.VarChar(5)
  endTime     String                  @map("end_time") @db.VarChar(5)
  isAvailable Boolean                 @default(true) @map("is_available")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([membershipId, dayOfWeek])
  @@map("driver_schedules")
}

model DriverVehicleAssignment {
  id           String                  @id @default(uuid()) @db.Uuid
  membershipId String                  @map("membership_id") @db.Uuid
  membership   DriverCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  vehicleId    String                  @map("vehicle_id") @db.Uuid
  vehicle      LogisticsVehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status       AssignmentStatus        @default(ACTIVE)
  assignedAt   DateTime                @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedAt      DateTime?               @map("ended_at") @db.Timestamptz(6)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([membershipId, status])
  @@index([vehicleId, status])
  @@map("driver_vehicle_assignments")
}

// ── Phase 9 L4: independent merchant clients ────────────────────────────────

enum LogisticsClientStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  ENDED
}

enum ClientRelationshipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

/// A merchant served by logistics companies. No marketplace vendor account required.
model LogisticsClient {
  id              String              @id @default(uuid()) @db.Uuid
  clientNumber    String              @unique @map("client_number")
  name            String
  businessName    String?             @map("business_name")
  phone           String?             @db.VarChar(40)
  email           String?             @db.VarChar(160)
  businessId      String?             @map("business_id") @db.Uuid
  vendorId        String?             @map("vendor_id") @db.Uuid
  address         String?             @db.VarChar(300)
  city            String?             @db.VarChar(120)
  latitude        Decimal?            @db.Decimal(10, 7)
  longitude       Decimal?            @db.Decimal(10, 7)
  status          LogisticsClientStatus @default(PROSPECT)
  referralCode    String?             @map("referral_code") @db.VarChar(64)
  verifiedAt      DateTime?           @map("verified_at") @db.Timestamptz(6)
  createdById     String?             @map("created_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  contacts        ClientContact[]
  relationships   CompanyClientRelationship[]
  contracts       LogisticsContract[]
  invoices        LogisticsInvoice[]
  referrals       PartnerReferral[]

  @@index([status, createdAt])
  @@map("logistics_clients")
}

/// A company's relationship to a merchant. A merchant may have several companies.
model CompanyClientRelationship {
  id            String                    @id @default(uuid()) @db.Uuid
  companyId     String                    @map("company_id") @db.Uuid
  company       LogisticsCompany          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId      String                    @map("client_id") @db.Uuid
  client        LogisticsClient           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status        ClientRelationshipStatus  @default(PENDING)
  accountCode   String?                   @map("account_code") @db.VarChar(64)
  serviceNotes  String?                   @map("service_notes") @db.Text
  verifiedById  String?                   @map("verified_by_id") @db.Uuid
  verifiedAt    DateTime?                 @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, clientId])
  @@index([companyId, status])
  @@map("company_client_relationships")
}

model ClientContact {
  id          String          @id @default(uuid()) @db.Uuid
  clientId    String          @map("client_id") @db.Uuid
  client      LogisticsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  role        String?         @db.VarChar(80)
  phone       String?         @db.VarChar(40)
  email       String?         @db.VarChar(160)
  isPrimary   Boolean         @default(false) @map("is_primary")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clientId, isPrimary])
  @@map("logistics_client_contacts")
}

// ── Phase 9 L5: commercial contracts, pricing and SLAs ──────────────────────

enum LogisticsContractType {
  PER_DELIVERY
  MONTHLY
  VOLUME
  DEDICATED_FLEET
  GEOGRAPHIC
  HYBRID
}

enum LogisticsContractStatus {
  DRAFT
  PROPOSED
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum PricingMode {
  PER_DELIVERY
  FLAT_MONTHLY
  TIERED_VOLUME
  PER_KM
}

model LogisticsContract {
  id               String                 @id @default(uuid()) @db.Uuid
  contractNumber   String                 @unique @map("contract_number")
  companyId        String                 @map("company_id") @db.Uuid
  company          LogisticsCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId         String                 @map("client_id") @db.Uuid
  client           LogisticsClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type             LogisticsContractType
  status           LogisticsContractStatus @default(DRAFT)
  version          Int                    @default(1)
  previousVersionId String?               @map("previous_version_id") @db.Uuid
  title            String
  description      String?                @db.Text
  currency         String                 @default("TZS") @db.VarChar(3)
  startsAt         DateTime               @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?              @map("ends_at") @db.Timestamptz(6)
  monthlyAllocation Int?                  @map("monthly_allocation")
  coverageArea     String?                @map("coverage_area") @db.VarChar(200)
  serviceHours     String?                @map("service_hours") @db.VarChar(120)
  paymentTerms     String?                @map("payment_terms") @db.VarChar(200)
  acceptedAt       DateTime?              @map("accepted_at") @db.Timestamptz(6)
  acceptedById     String?                @map("accepted_by_id") @db.Uuid
  suspendedAt      DateTime?              @map("suspended_at") @db.Timestamptz(6)
  terminatedAt     DateTime?              @map("terminated_at") @db.Timestamptz(6)
  terminationReason String?               @map("termination_reason") @db.Text
  createdById      String?                @map("created_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  pricing          ContractPricing?
  sla              ContractSla?
  deliveries       ContractDelivery[]
  invoices         LogisticsInvoice[]
  deliveryRequests DeliveryRequest[]
  deliveryJobs     DeliveryJob[]

  @@index([companyId, status])
  @@index([clientId, status])
  @@map("logistics_contracts")
}

model ContractPricing {
  id            String              @id @default(uuid()) @db.Uuid
  contractId    String              @unique @map("contract_id") @db.Uuid
  contract      LogisticsContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  mode          PricingMode
  currency      String              @default("TZS") @db.VarChar(3)
  perDelivery   Decimal?            @map("per_delivery") @db.Decimal(12, 2)
  monthlyFee    Decimal?            @map("monthly_fee") @db.Decimal(12, 2)
  perKmRate     Decimal?            @map("per_km_rate") @db.Decimal(12, 2)
  minimumFee    Decimal?            @map("minimum_fee") @db.Decimal(12, 2)
  includedUnits Int?                @map("included_units")
  tierJson      Json?               @map("tier_json")
  notes         String?             @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("contract_pricing")
}

model ContractSla {
  id                 String            @id @default(uuid()) @db.Uuid
  contractId         String            @unique @map("contract_id") @db.Uuid
  contract           LogisticsContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  maxDeliveryHours   Int?              @map("max_delivery_hours")
  minCompletionRateBps Int?            @map("min_completion_rate_bps")
  proofRequired      Boolean           @default(true) @map("proof_required")
  otpRequired        Boolean           @default(true) @map("otp_required")
  claimsWindowDays   Int?              @map("claims_window_days")
  notes              String?           @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("contract_slas")
}

/// A delivery performed under a contract, linked to the shared DeliveryJob.
model ContractDelivery {
  id             String            @id @default(uuid()) @db.Uuid
  contractId     String            @map("contract_id") @db.Uuid
  contract       LogisticsContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliveryJobId  String?           @unique @map("delivery_job_id") @db.Uuid
  reference      String            @db.VarChar(120)
  status         String            @default("PENDING") @db.VarChar(40)
  charge         Decimal           @db.Decimal(12, 2)
  currency       String            @default("TZS") @db.VarChar(3)
  deliveredAt    DateTime?         @map("delivered_at") @db.Timestamptz(6)
  note           String?           @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contractId, status])
  @@map("contract_deliveries")
}

enum LogisticsInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

model LogisticsInvoice {
  id           String                 @id @default(uuid()) @db.Uuid
  invoiceNumber String                @unique @map("invoice_number")
  contractId   String                 @map("contract_id") @db.Uuid
  contract     LogisticsContract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  companyId    String                 @map("company_id") @db.Uuid
  clientId     String                 @map("client_id") @db.Uuid
  status       LogisticsInvoiceStatus @default(DRAFT)
  currency     String                 @default("TZS") @db.VarChar(3)
  subtotal     Decimal                @db.Decimal(12, 2)
  total        Decimal                @db.Decimal(12, 2)
  periodStart  DateTime               @map("period_start") @db.Timestamptz(6)
  periodEnd    DateTime               @map("period_end") @db.Timestamptz(6)
  dueAt        DateTime?              @map("due_at") @db.Timestamptz(6)
  paidAt       DateTime?              @map("paid_at") @db.Timestamptz(6)
  note         String?                @db.Text
  createdById  String?                @map("created_by_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  items        LogisticsInvoiceItem[]
  company      LogisticsCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       LogisticsClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([clientId, createdAt])
  @@map("logistics_invoices")
}

model LogisticsInvoiceItem {
  id          String            @id @default(uuid()) @db.Uuid
  invoiceId   String            @map("invoice_id") @db.Uuid
  invoice     LogisticsInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String            @db.VarChar(300)
  quantity    Int               @default(1)
  unitPrice   Decimal           @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal           @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("logistics_invoice_items")
}

