generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ProductImageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryReason {
  INITIAL
  RESTOCK
  CORRECTION
  RETURN
  SALE
  RELEASE
  RESERVE
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

// ── Phase 4: Shared Logistics Network ───────────────────────────────────────

enum AgentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgentPresence {
  OFFLINE
  ONLINE
}

