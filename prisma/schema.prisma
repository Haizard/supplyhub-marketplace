// ── Phase 9 L11: fleet sharing and parcel hubs ──────────────────────────────

enum FleetShareType {
  VEHICLE_LENDING
  SUBCONTRACT_DELIVERY
}

enum FleetShareStatus {
  DRAFT
  PENDING_PARTNER
  ACTIVE
  SUSPENDED
  DECLINED
  TERMINATED
}

enum FleetShareUsageStatus {
  RESERVED
  IN_USE
  RELEASED
  CANCELLED
}

enum ParcelHubStatus {
  ACTIVE
  INACTIVE
}

enum ParcelHandoverDirection {
  INTAKE
  COLLECTION
}

enum ParcelHandoverStatus {
  RECEIVED
  STORED
  RELEASED
  RETURNED
}

/// Two logistics companies agreeing to share capacity. Consent is explicit on both
/// sides, insurance is recorded, and exactly one company is accountable per delivery.
model FleetShareAgreement {
  id                   String            @id @default(uuid()) @db.Uuid
  agreementNumber      String            @unique @map("agreement_number") @db.VarChar(40)
  ownerCompanyId       String            @map("owner_company_id") @db.Uuid
  ownerCompany         LogisticsCompany  @relation("FleetShareOwner", fields: [ownerCompanyId], references: [id], onDelete: Cascade)
  partnerCompanyId     String            @map("partner_company_id") @db.Uuid
  partnerCompany       LogisticsCompany  @relation("FleetSharePartner", fields: [partnerCompanyId], references: [id], onDelete: Cascade)
  type                 FleetShareType
  status               FleetShareStatus  @default(PENDING_PARTNER)
  /// Configurable commercial terms. The platform does not move money for these.
  rateAmount           Decimal?          @map("rate_amount") @db.Decimal(12, 2)
  rateCurrency         String?           @map("rate_currency") @db.VarChar(3)
  liabilityTerms       String?           @map("liability_terms") @db.VarChar(1000)
  insurancePolicyRef   String?           @map("insurance_policy_ref") @db.VarChar(160)
  insuranceExpiresAt   DateTime?         @map("insurance_expires_at") @db.Timestamptz(6)
  /// Exactly one accountable company per shared delivery; must be owner or partner.
  accountableCompanyId String            @map("accountable_company_id") @db.Uuid
  ownerConsentedAt     DateTime?         @map("owner_consented_at") @db.Timestamptz(6)
  ownerConsentedById   String?           @map("owner_consented_by_id") @db.Uuid
  partnerConsentedAt   DateTime?         @map("partner_consented_at") @db.Timestamptz(6)
  partnerConsentedById String?           @map("partner_consented_by_id") @db.Uuid
  effectiveFrom        DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveTo          DateTime?         @map("effective_to") @db.Timestamptz(6)
  suspendedAt          DateTime?         @map("suspended_at") @db.Timestamptz(6)
  terminatedAt         DateTime?         @map("terminated_at") @db.Timestamptz(6)
  terminationReason    String?           @map("termination_reason") @db.VarChar(500)
  createdById          String            @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicles             FleetShareVehicle[]
  usages               FleetShareUsage[]

  @@index([ownerCompanyId, status])
  @@index([partnerCompanyId, status])
  @@map("fleet_share_agreements")
}

/// A vehicle the owner has offered under an agreement.
model FleetShareVehicle {
  id          String              @id @default(uuid()) @db.Uuid
  agreementId String              @map("agreement_id") @db.Uuid
  agreement   FleetShareAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  vehicleId   String              @map("vehicle_id") @db.Uuid
  vehicle     LogisticsVehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  active      Boolean             @default(true)
  addedAt     DateTime            @default(now()) @map("added_at") @db.Timestamptz(6)

  @@unique([agreementId, vehicleId])
  @@index([vehicleId, active])
  @@map("fleet_share_vehicles")
}

/// Accountability record for a specific shared-capacity use. Written before a job is
/// dispatched on a borrowed vehicle so the responsible company is never ambiguous.
model FleetShareUsage {
  id                   String               @id @default(uuid()) @db.Uuid
  agreementId          String               @map("agreement_id") @db.Uuid
  agreement            FleetShareAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  vehicleId            String               @map("vehicle_id") @db.Uuid
  vehicle              LogisticsVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  usingCompanyId       String               @map("using_company_id") @db.Uuid
  accountableCompanyId String               @map("accountable_company_id") @db.Uuid
  jobId                String?              @map("job_id") @db.Uuid
  job                  DeliveryJob?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status               FleetShareUsageStatus @default(RESERVED)
  startedAt            DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?            @map("ended_at") @db.Timestamptz(6)

  @@index([agreementId, status])
  @@index([vehicleId, status])
  @@map("fleet_share_usages")
}

/// A physical parcel hub where custody of a parcel changes hands. Capacity is
/// enforced so a hub cannot be over-promised.
model ParcelHub {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  company        LogisticsCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hubCode        String             @map("hub_code") @db.VarChar(40)
  name           String             @db.VarChar(160)
  address        String             @db.VarChar(300)
  city           String?            @db.VarChar(120)
  latitude       Decimal?           @db.Decimal(10, 7)
  longitude      Decimal?           @db.Decimal(10, 7)
  capacity       Int                @default(50)
  status         ParcelHubStatus    @default(ACTIVE)
  operatingHours Json?              @map("operating_hours")
  createdById    String             @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  handovers      ParcelHubHandover[]

  @@unique([companyId, hubCode])
  @@index([companyId, status])
  @@map("parcel_hubs")
}

/// Custody chain entry. The pickup code is revealed once at intake and required at
/// release, so a parcel cannot be handed to the wrong person silently.
model ParcelHubHandover {
  id                  String                 @id @default(uuid()) @db.Uuid
  hubId               String                 @map("hub_id") @db.Uuid
  hub                 ParcelHub              @relation(fields: [hubId], references: [id], onDelete: Cascade)
  companyId           String                 @map("company_id") @db.Uuid
  trackingRef         String                 @map("tracking_ref") @db.VarChar(120)
  direction           ParcelHandoverDirection
  status              ParcelHandoverStatus   @default(RECEIVED)
  jobId               String?                @map("job_id") @db.Uuid
  job                 DeliveryJob?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  custodianMemberId   String?                @map("custodian_member_id") @db.Uuid
  receivedById        String                 @map("received_by_id") @db.Uuid
  receivedAt          DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  pickupCode          String                 @map("pickup_code") @db.VarChar(12)
  pickupCodeVerifiedAt DateTime?             @map("pickup_code_verified_at") @db.Timestamptz(6)
  releasedAt          DateTime?              @map("released_at") @db.Timestamptz(6)
  releasedToName      String?                @map("released_to_name") @db.VarChar(160)
  releasedToPhone     String?                @map("released_to_phone") @db.VarChar(40)
  notes               String?                @db.VarChar(500)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([hubId, status])
  @@index([companyId, status])
  @@index([trackingRef])
  @@map("parcel_hub_handovers")
}

// ── Phase 9 L12: advisory logistics optimisation ─────────────────────────────

enum OptimizationSource {
  BASELINE
  AI
}

enum OptimizationStatus {
  PENDING
  ACCEPTED
  REJECTED
  BASELINE_USED
}

/// An advisory ranking. Nothing here assigns a job; the existing dispatch action
/// remains the only state transition. The deterministic baseline is always stored.
model LogisticsOptimizationSuggestion {
  id               String               @id @default(uuid()) @db.Uuid
  suggestionNumber String               @unique @map("suggestion_number") @db.VarChar(40)
  companyId        String               @map("company_id") @db.Uuid
  company          LogisticsCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestId        String               @map("request_id") @db.Uuid
  request          DeliveryRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdById      String               @map("created_by_id") @db.Uuid
  source           OptimizationSource
  status           OptimizationStatus   @default(PENDING)
  model            String?              @db.VarChar(80)
  inputHash        String               @map("input_hash") @db.VarChar(64)
  baselineRanking  Json                 @map("baseline_ranking")
  ranking          Json
  note             String?              @db.VarChar(500)
  decidedAt        DateTime?            @map("decided_at") @db.Timestamptz(6)
  decidedById      String?              @map("decided_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@map("logistics_optimization_suggestions")
}

// ── Phase 10 I1: seller-funded installment sales ─────────────────────────────

enum InstallmentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InstallmentDepositMode {
  FIXED
  PERCENTAGE
}

enum InstallmentPossession {
  IMMEDIATE
  AFTER_FULL_PAYMENT
}

enum InstallmentSource {
  MARKETPLACE
  OFFLINE
}

enum InstallmentAgreementStatus {
  DRAFT
  PENDING_CUSTOMER_ACCEPTANCE
  PENDING_DEPOSIT
  ACTIVE
  OVERDUE
  COMPLETED
  DEFAULTED
  CANCELLED
  DISPUTED
}

enum InstallmentScheduleStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

/// Seller-controlled defaults. Every monetary/legal term is a configurable default
/// and is disabled until the seller explicitly enables and reviews it.
model InstallmentSetting {
  id                    String                 @id @default(uuid()) @db.Uuid
  businessId            String                 @unique @map("business_id") @db.Uuid
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled               Boolean                @default(false)
  currency              String                 @default("TZS") @db.VarChar(3)
  defaultDepositMode    InstallmentDepositMode @default(PERCENTAGE) @map("default_deposit_mode")
  defaultDepositValue   Decimal                @default(20) @map("default_deposit_value") @db.Decimal(12, 2)
  defaultFrequency      InstallmentFrequency   @default(MONTHLY) @map("default_frequency")
  defaultInstallmentCount Int                   @default(6) @map("default_installment_count")
  defaultPossession     InstallmentPossession  @default(AFTER_FULL_PAYMENT) @map("default_possession")
  gracePeriodDays       Int                    @default(0) @map("grace_period_days")
  allowInterest         Boolean                @default(false) @map("allow_interest")
  interestRateBps       Int                    @default(0) @map("interest_rate_bps")
  allowLateFees         Boolean                @default(false) @map("allow_late_fees")
  lateFeeBps            Int                    @default(0) @map("late_fee_bps")
  allowAdvancePayments  Boolean                @default(false) @map("allow_advance_payments")
  maxInstallments       Int                    @default(24) @map("max_installments")
  termsSummary          String?                @map("terms_summary") @db.Text
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("installment_settings")
}

/// One buyer-seller contract. Prices, seller identity and terms are snapshotted at
/// creation so later catalogue or settings changes never rewrite an agreement.
model InstallmentAgreement {
  id                    String                     @id @default(uuid()) @db.Uuid
  agreementNumber       String                     @unique @map("agreement_number") @db.VarChar(40)
  businessId            String                     @map("business_id") @db.Uuid
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyerUserId           String                     @map("buyer_user_id") @db.Uuid
  buyer                 User                       @relation("InstallmentBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  source                InstallmentSource
  orderId               String?                    @map("order_id") @db.Uuid
  order                 Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  currency              String                     @db.VarChar(3)
  cashPrice             Decimal                    @map("cash_price") @db.Decimal(14, 2)
  depositAmount         Decimal                    @map("deposit_amount") @db.Decimal(14, 2)
  interestAmount        Decimal                    @default(0) @map("interest_amount") @db.Decimal(14, 2)
  extraCharges          Decimal                    @default(0) @map("extra_charges") @db.Decimal(14, 2)
  totalPayable          Decimal                    @map("total_payable") @db.Decimal(14, 2)
  outstandingBalance    Decimal                    @map("outstanding_balance") @db.Decimal(14, 2)
  advanceCreditAmount   Decimal                    @default(0) @map("advance_credit_amount") @db.Decimal(14, 2)
  depositMode           InstallmentDepositMode     @map("deposit_mode")
  frequency             InstallmentFrequency
  installmentCount      Int                        @map("installment_count")
  installmentAmount     Decimal                    @map("installment_amount") @db.Decimal(14, 2)
  possessionModel       InstallmentPossession      @map("possession_model")
  gracePeriodDays       Int                        @default(0) @map("grace_period_days")
  interestPolicy        String?                    @map("interest_policy") @db.VarChar(300)
  latePaymentPolicy     String?                    @map("late_payment_policy") @db.VarChar(500)
  notes                 String?                    @db.Text
  status                InstallmentAgreementStatus @default(DRAFT)
  /// Immutable contract snapshot: seller identity, items, prices, terms and schedule.
  termsSnapshot         Json                       @map("terms_snapshot")
  sellerAcceptedAt      DateTime?                  @map("seller_accepted_at") @db.Timestamptz(6)
  sellerAcceptedById    String?                    @map("seller_accepted_by_id") @db.Uuid
  buyerAcceptedAt       DateTime?                  @map("buyer_accepted_at") @db.Timestamptz(6)
  buyerAcceptanceMethod String?                    @map("buyer_acceptance_method") @db.VarChar(60)
  activatedAt           DateTime?                  @map("activated_at") @db.Timestamptz(6)
  completedAt           DateTime?                  @map("completed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?                    @map("cancellation_reason") @db.VarChar(500)
  createdById           String                     @map("created_by_id") @db.Uuid
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items                 InstallmentAgreementItem[]
  schedule              InstallmentSchedule[]
  events                InstallmentAgreementEvent[]
  payments              InstallmentPayment[]
  receipts              InstallmentReceipt[]
  reminders             InstallmentReminder[]
  stockReservation      InstallmentStockReservation?
  disputes              InstallmentDispute[]
  contractDocuments     InstallmentContractDocument[]
  amendments            InstallmentAmendment[]
  financingApplications InstallmentFinancingApplication[]

  @@index([businessId, status])
  @@index([buyerUserId, status])
  @@map("installment_agreements")
}

model InstallmentAgreementItem {
  id           String                @id @default(uuid()) @db.Uuid
  agreementId  String                @map("agreement_id") @db.Uuid
  agreement    InstallmentAgreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  productId    String?               @map("product_id") @db.Uuid
  productName  String                @map("product_name") @db.VarChar(200)
  sku          String?               @db.VarChar(80)
  quantity     Int
  unitPrice    Decimal               @map("unit_price") @db.Decimal(14, 2)
  lineTotal    Decimal               @map("line_total") @db.Decimal(14, 2)

  @@index([agreementId])
  @@map("installment_agreement_items")
}

model InstallmentSchedule {
  id          String                  @id @default(uuid()) @db.Uuid
  agreementId String                  @map("agreement_id") @db.Uuid
  agreement   InstallmentAgreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  sequence    Int
  dueDate     DateTime                @map("due_date") @db.Timestamptz(6)
  amount      Decimal                 @db.Decimal(14, 2)
  currency    String                  @db.VarChar(3)
  status      InstallmentScheduleStatus @default(PENDING)
  paidAmount  Decimal                 @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paidAt      DateTime?               @map("paid_at") @db.Timestamptz(6)
  allocations InstallmentPaymentAllocation[]

  @@unique([agreementId, sequence])
  @@index([dueDate, status])
  @@map("installment_schedules")
}

model InstallmentAgreementEvent {
  id         String               @id @default(uuid()) @db.Uuid
  agreementId String              @map("agreement_id") @db.Uuid
  agreement  InstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type       String               @db.VarChar(60)
  fromStatus String?              @map("from_status") @db.VarChar(40)
  toStatus   String?              @map("to_status") @db.VarChar(40)
  actorId    String?              @map("actor_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agreementId, createdAt])
  @@map("installment_agreement_events")
}

// ── Phase 10 I2: verified installment payments ───────────────────────────────

enum InstallmentPaymentMethod {
  MPESA
  TIGOPESA
  AIRTEL
  HALOPESA
  CARD
  BANK
  CASH
}

enum InstallmentPaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum InstallmentPaymentEventOutcome {
  APPLIED
  DUPLICATE
  MISMATCH
  IGNORED
  ERROR
}

/// A single attempted payment. `reference` is our idempotency key and is sent to
/// the provider as external_id; provider callbacks are the only verification source.
model InstallmentPayment {
  id                String                  @id @default(uuid()) @db.Uuid
  reference         String                  @unique @db.VarChar(80)
  agreementId       String                  @map("agreement_id") @db.Uuid
  agreement         InstallmentAgreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  buyerUserId       String                  @map("buyer_user_id") @db.Uuid
  amount            Decimal                 @db.Decimal(14, 2)
  currency          String                  @db.VarChar(3)
  method            InstallmentPaymentMethod
  status            InstallmentPaymentStatus @default(PENDING)
  provider          String?                 @db.VarChar(40)
  providerPaymentId String?                 @unique @map("provider_payment_id") @db.VarChar(120)
  providerReference String?                 @map("provider_reference") @db.VarChar(160)
  checkoutUrl       String?                 @map("checkout_url") @db.VarChar(500)
  paidAt            DateTime?               @map("paid_at") @db.Timestamptz(6)
  verifiedAt        DateTime?               @map("verified_at") @db.Timestamptz(6)
  verifiedById      String?                 @map("verified_by_id") @db.Uuid
  failureReason     String?                 @map("failure_reason") @db.VarChar(500)
  createdById       String?                 @map("created_by_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  allocations       InstallmentPaymentAllocation[]
  events            InstallmentPaymentEvent[]
  receipt           InstallmentReceipt?
  disputes          InstallmentDispute[]
  reconciliationFindings InstallmentReconciliationFinding[]

  @@index([agreementId, status])
  @@index([buyerUserId, createdAt])
  @@map("installment_payments")
}

/// Immutable allocation rows: how a verified payment was applied to instalments.
model InstallmentPaymentAllocation {
  id         String             @id @default(uuid()) @db.Uuid
  paymentId  String             @map("payment_id") @db.Uuid
  payment    InstallmentPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  scheduleId String             @map("schedule_id") @db.Uuid
  schedule   InstallmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  amount     Decimal            @db.Decimal(14, 2)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([paymentId, scheduleId])
  @@index([scheduleId])
  @@map("installment_payment_allocations")
}

/// Raw provider delivery log with a unique delivery key; duplicate webhooks are recorded
/// but never apply a second financial mutation.
model InstallmentPaymentEvent {
  id          String                        @id @default(uuid()) @db.Uuid
  provider    String                        @db.VarChar(40)
  deliveryId  String                        @map("delivery_id") @db.VarChar(128)
  eventType   String                        @map("event_type") @db.VarChar(64)
  paymentId   String?                       @map("payment_id") @db.Uuid
  payment     InstallmentPayment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  agreementId String?                       @map("agreement_id") @db.Uuid
  outcome     InstallmentPaymentEventOutcome
  status      String?                       @db.VarChar(40)
  payload     Json
  errorMessage String?                      @map("error_message") @db.VarChar(500)
  processedAt DateTime?                     @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, deliveryId])
  @@index([paymentId, createdAt])
  @@map("installment_payment_events")
}

// ── Phase 10 I3: receipts, reminders and overdue management ──────────────────

enum InstallmentReminderType {
  UPCOMING
  OVERDUE
}

enum InstallmentReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Issued exactly once per verified payment. The receipt text is derived from the
/// frozen agreement snapshot, never from current catalogue or seller settings.
model InstallmentReceipt {
  id             String               @id @default(uuid()) @db.Uuid
  receiptNumber  String               @unique @map("receipt_number") @db.VarChar(40)
  paymentId      String               @unique @map("payment_id") @db.Uuid
  payment        InstallmentPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  agreementId    String               @map("agreement_id") @db.Uuid
  agreement      InstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  buyerUserId    String               @map("buyer_user_id") @db.Uuid
  issuedAt       DateTime             @default(now()) @map("issued_at") @db.Timestamptz(6)

  @@index([buyerUserId, issuedAt])
  @@map("installment_receipts")
}

model InstallmentReminder {
  id           String                    @id @default(uuid()) @db.Uuid
  agreementId  String                    @map("agreement_id") @db.Uuid
  agreement    InstallmentAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  /// Schedule ID or "agreement" for a contract-level reminder.
  scopeKey     String                    @map("scope_key") @db.VarChar(80)
  reminderType InstallmentReminderType   @map("reminder_type")
  status       InstallmentReminderStatus @default(PENDING)
  dueAt        DateTime                  @map("due_at") @db.Timestamptz(6)
  attempts     Int                       @default(0)
  sentAt       DateTime?                 @map("sent_at") @db.Timestamptz(6)
  lastError    String?                   @map("last_error") @db.VarChar(500)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([agreementId, scopeKey, reminderType])
  @@index([status, dueAt])
  @@map("installment_reminders")
}

// ── Phase 10 I4: installment stock reservations and POS sales ────────────────

enum InstallmentStockReservationStatus {
  HELD
  SOLD
  RELEASED
}

/// Stock held for an installment agreement. HELD reduces available stock but is
/// not a sale; SOLD converts the same units once possession terms are met.
model InstallmentStockReservation {
  id          String                          @id @default(uuid()) @db.Uuid
  agreementId String                          @unique @map("agreement_id") @db.Uuid
  agreement   InstallmentAgreement            @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  productId   String                          @map("product_id") @db.Uuid
  product     Product                         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String                          @map("warehouse_id") @db.Uuid
  warehouse   Warehouse                       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Int
  status      InstallmentStockReservationStatus @default(HELD)
  soldAt      DateTime?                       @map("sold_at") @db.Timestamptz(6)
  releasedAt  DateTime?                       @map("released_at") @db.Timestamptz(6)
  createdAt   DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, status])
  @@map("installment_stock_reservations")
}

// ── Phase 10 I5: installment disputes and reconciliation ─────────────────────

enum InstallmentDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum InstallmentReconciliationStatus {
  RUNNING
  COMPLETED
  FAILED
}

model InstallmentDispute {
  id            String                  @id @default(uuid()) @db.Uuid
  disputeNumber String                  @unique @map("dispute_number") @db.VarChar(40)
  agreementId   String                  @map("agreement_id") @db.Uuid
  agreement     InstallmentAgreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  paymentId     String?                 @map("payment_id") @db.Uuid
  payment       InstallmentPayment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  openedById    String                  @map("opened_by_id") @db.Uuid
  openedBy      User                    @relation("InstallmentDisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  openedByRole  String                  @map("opened_by_role") @db.VarChar(20)
  reason        String                  @db.Text
  status        InstallmentDisputeStatus @default(OPEN)
  resolution    String?                 @db.Text
  resolvedById  String?                 @map("resolved_by_id") @db.Uuid
  resolvedAt    DateTime?               @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agreementId, status])
  @@map("installment_disputes")
}

model InstallmentReconciliationRun {
  id             String                        @id @default(uuid()) @db.Uuid
  runNumber      String                        @unique @map("run_number") @db.VarChar(40)
  businessId     String                        @map("business_id") @db.Uuid
  business       Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status         InstallmentReconciliationStatus @default(RUNNING)
  checkedCount   Int                           @default(0) @map("checked_count")
  findingCount   Int                           @default(0) @map("finding_count")
  initiatedById  String?                       @map("initiated_by_id") @db.Uuid
  finishedAt     DateTime?                     @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  findings       InstallmentReconciliationFinding[]

  @@index([businessId, createdAt])
  @@map("installment_reconciliation_runs")
}

model InstallmentReconciliationFinding {
  id                   String                       @id @default(uuid()) @db.Uuid
  runId                String                       @map("run_id") @db.Uuid
  run                  InstallmentReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  installmentPaymentId String?                      @map("installment_payment_id") @db.Uuid
  installmentPayment  InstallmentPayment?           @relation(fields: [installmentPaymentId], references: [id], onDelete: SetNull)
  severity             FindingSeverity
  code                 String                       @db.VarChar(80)
  message              String                       @db.Text
  expected             String?                      @db.VarChar(80)
  actual               String?                      @db.VarChar(80)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([runId, severity])
  @@map("installment_reconciliation_findings")
}

// ── Phase 10 I6-I8: contract documents, advanced reporting, financing interface ──

enum InstallmentDocumentStatus {
  DRAFT
  PENDING_SIGNATURES
  SIGNED
  VOID
}

enum InstallmentSignatureRole {
  BUYER
  SELLER
}

enum InstallmentAmendmentStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum InstallmentFinancingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  DECLINED
  FUNDED
  CANCELLED
}

/// Versioned human-readable contract. The frozen terms snapshot is never rewritten;
/// a new version stores a new document instead.
model InstallmentContractDocument {
  id             String                    @id @default(uuid()) @db.Uuid
  documentNumber String                    @unique @map("document_number") @db.VarChar(40)
  agreementId    String                    @map("agreement_id") @db.Uuid
  agreement      InstallmentAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  version        Int
  body           String                    @db.Text
  contentHash    String                    @map("content_hash") @db.VarChar(64)
  status         InstallmentDocumentStatus @default(DRAFT)
  createdById    String                    @map("created_by_id") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  signatures     InstallmentContractSignature[]

  @@unique([agreementId, version])
  @@map("installment_contract_documents")
}

model InstallmentContractSignature {
  id           String                      @id @default(uuid()) @db.Uuid
  documentId   String                      @map("document_id") @db.Uuid
  document     InstallmentContractDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signerUserId String                      @map("signer_user_id") @db.Uuid
  signer       User                        @relation("InstallmentSigner", fields: [signerUserId], references: [id], onDelete: Restrict)
  role         InstallmentSignatureRole
  method       String                      @default("ACCOUNT_SESSION") @db.VarChar(40)
  evidenceHash String                      @map("evidence_hash") @db.VarChar(64)
  signedAt     DateTime                    @default(now()) @map("signed_at") @db.Timestamptz(6)

  @@unique([documentId, role])
  @@map("installment_contract_signatures")
}

/// Proposed term changes are recorded as history. They never mutate the original
/// frozen snapshot; accepting one creates a new document version instead.
model InstallmentAmendment {
  id             String                    @id @default(uuid()) @db.Uuid
  amendmentNumber String                   @unique @map("amendment_number") @db.VarChar(40)
  agreementId    String                    @map("agreement_id") @db.Uuid
  agreement      InstallmentAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  version        Int
  reason         String                    @db.Text
  changes        Json
  status         InstallmentAmendmentStatus @default(PROPOSED)
  proposedById   String                    @map("proposed_by_id") @db.Uuid
  decidedById    String?                   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?                 @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([agreementId, createdAt])
  @@map("installment_amendments")
}

/// Prepared interface only. No partner API calls or money movement are implemented;
/// a separate disabled flag and compliance approval are required before use.
model InstallmentFinancingApplication {
  id                String                     @id @default(uuid()) @db.Uuid
  applicationNumber String                     @unique @map("application_number") @db.VarChar(40)
  agreementId       String                     @map("agreement_id") @db.Uuid
  agreement         InstallmentAgreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  partnerCode       String                     @map("partner_code") @db.VarChar(60)
  requestedAmount   Decimal                    @map("requested_amount") @db.Decimal(14, 2)
  currency          String                     @db.VarChar(3)
  status            InstallmentFinancingStatus @default(DRAFT)
  decisionNote      String?                    @map("decision_note") @db.Text
  submittedById     String                     @map("submitted_by_id") @db.Uuid
  decidedById       String?                    @map("decided_by_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([agreementId, status])
  @@map("installment_financing_applications")
}
