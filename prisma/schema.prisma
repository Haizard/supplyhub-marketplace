enum DriverCompensationMode {
  FIXED_MONTHLY
  PER_DELIVERY
  PERCENTAGE
  DAILY
  HYBRID
}

enum DriverEarningStatus {
  PENDING
  APPROVED
  PAID
}

enum DriverPayoutStatus {
  DRAFT
  APPROVED
  PAID
  FAILED
}

enum LogisticsExpenseCategory {
  FUEL
  MAINTENANCE
  INSURANCE
  SALARY
  RENT
  UTILITIES
  PLATFORM_FEE
  OTHER
}

enum LogisticsSettlementStatus {
  DRAFT
  RECONCILED
  DISPUTED
}

model DriverCompensationRule {
  id            String                  @id @default(uuid()) @db.Uuid
  membershipId  String                  @unique @map("membership_id") @db.Uuid
  membership    DriverCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  mode          DriverCompensationMode
  currency      String                  @default("TZS") @db.VarChar(3)
  fixedAmount   Decimal?                @map("fixed_amount") @db.Decimal(12, 2)
  perDelivery   Decimal?                @map("per_delivery") @db.Decimal(12, 2)
  rateBps       Int?                    @map("rate_bps")
  dailyAmount   Decimal?                @map("daily_amount") @db.Decimal(12, 2)
  effectiveFrom DateTime                @map("effective_from") @db.Timestamptz(6)
  notes         String?                 @db.Text
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("driver_compensation_rules")
}

model DriverEarning {
  id            String              @id @default(uuid()) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  company       LogisticsCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipId  String              @map("membership_id") @db.Uuid
  membership    DriverCompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  jobId         String?             @unique @map("job_id") @db.Uuid
  basis         String              @db.VarChar(40)
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("TZS") @db.VarChar(3)
  status        DriverEarningStatus @default(PENDING)
  ruleVersion   String?             @map("rule_version") @db.VarChar(40)
  note          String?             @db.Text
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(6)
